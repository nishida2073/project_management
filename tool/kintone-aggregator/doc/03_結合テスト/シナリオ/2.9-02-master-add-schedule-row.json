{
  "name": "2.9-02 環境設定（マスター）で追加（スケジュール）を押すと、2行目の通番が2になり、科目名が空になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/追加（スケジュール）"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの通番（2行目）",
      "pattern": "^2$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの科目名（2行目）",
      "pattern": ".",
      "timeoutSec": 10,
      "absent": true
    },
    {
      "action": "shot"
    }
  ]
}
