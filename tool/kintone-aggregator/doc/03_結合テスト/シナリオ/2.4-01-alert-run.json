{
  "name": "2.4-01 アラート集計で、対象日と対象のグループを入力して実行すると、状態が成功または警告になり、アラート結果が作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（業務日誌）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（業務日誌）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（業務日誌）"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（パルスサーベイ）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（パルスサーベイ）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（パルスサーベイ）"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ集計タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ集計）/対象日",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ集計）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ集計）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/アラート集計タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（アラート集計）/対象日（業務日誌・パルスサーベイ）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アラート集計）/対象のグループ（業務日誌・パルスサーベイ）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アラート集計）/実行（業務日誌・パルスサーベイ）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "expectFile",
      "path": "output/03_アラート検知結果/ok.xlsx",
      "exists": true
    }
  ]
}
