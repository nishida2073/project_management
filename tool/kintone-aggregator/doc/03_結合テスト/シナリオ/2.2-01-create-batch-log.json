{
  "name": "2.2-01 アプリデータ作成の業務日誌で、対象日と対象のグループを入力して実行すると、状態が成功または警告になり、集計用データが作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（業務日誌）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（業務日誌）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（業務日誌）"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextAt",
      "part": "実行（アプリデータ作成）/状態（業務日誌）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "expectFile",
      "path": "output/01_提出状況/2026-09-01/ok-業務日誌.txt",
      "exists": true
    }
  ]
}
