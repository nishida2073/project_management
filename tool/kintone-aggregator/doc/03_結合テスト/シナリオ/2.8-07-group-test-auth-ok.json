{
  "name": "2.8-07 正しい接続情報でテスト接続（認証情報）を押すと、状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/再読込"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（認証情報）"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（認証情報）",
      "pattern": "^成功$",
      "timeoutSec": 120
    }
  ]
}
