{
  "name": "2.6-04 ログの対象のグループを、すべて・ok・ng と切り替えると、選んだグループの実行ログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/create-daily-report-ok-2026-09-01_20261021_000000.log",
      "text": "daily ok run"
    },
    {
      "action": "writeFile",
      "path": "logs/create-daily-report-ng-2026-09-01_20261021_000000.log",
      "text": "daily ng run"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectEditContains",
      "text": "daily ok run",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "daily ng run",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "expectEditContains",
      "text": "daily ok run",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "daily ng run",
      "timeoutSec": 30
    }
  ]
}
