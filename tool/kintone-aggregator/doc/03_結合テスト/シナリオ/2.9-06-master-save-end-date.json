{
  "name": "2.9-06 環境設定（マスター）で終了日を変えて保存すると、変えた値が保存され、Excel の終了日が更新される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "環境設定（マスター）/スケジュールの終了日（1行目）",
      "value": "saved-end-date"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの終了日（1行目）",
      "pattern": "^saved-end-date$",
      "timeoutSec": 15
    },
    {
      "action": "excelExpect",
      "path": "clients/ok.xlsx",
      "sheet": "スケジュール",
      "cell": "D2",
      "equals": "saved-end-date"
    },
    {
      "action": "shot"
    }
  ]
}
