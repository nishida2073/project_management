{
  "name": "2.5-02 投稿の実行が終わったあと、開くを押すと、対象のスレッドがブラウザで開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "output/03_アラート検知結果/backup"
    },
    {
      "action": "copyFile",
      "from": "template/アラート検知.xlsx",
      "to": "output/03_アラート検知結果/backup/{{client}}-2026-09-01.xlsx"
    },
    {
      "action": "writeFile",
      "path": "output/03_アラート検知結果/backup/{{client}}-2026-09-01.json",
      "text": "[{\"クラス名\":\"ok\",\"業務日誌未提出人数\":0,\"パルスサーベイ未提出人数\":0,\"アラート人数\":0}]",
      "encoding": "UTF8"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アラート集計タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アラート集計）/対象日（投稿）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アラート集計）/対象のグループ（投稿）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アラート集計）/実行（投稿）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（アラート集計）/状態（投稿）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（アラート集計）/開く（投稿）"
    },
    {
      "action": "expectWindow",
      "title": "Google Chrome",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "Google Chrome",
      "keys": "^w"
    }
  ]
}
