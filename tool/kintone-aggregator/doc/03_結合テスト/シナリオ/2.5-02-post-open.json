      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 350,
      "y": 79
    },
    {
      "action": "typeAt",
      "x": 328,
      "y": 268,
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
