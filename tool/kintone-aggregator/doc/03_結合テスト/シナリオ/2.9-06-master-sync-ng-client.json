{
  "name": "2.9-06 異常のクライアント（ng）で同期実行を押すと、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/同期実行"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/状態（同期実行）",
      "pattern": "^失敗$",
      "timeoutSec": 300
    }
  ]
}
