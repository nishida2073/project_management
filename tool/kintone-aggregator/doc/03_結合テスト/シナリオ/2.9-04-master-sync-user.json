{
  "name": "2.9-04 環境設定（マスター）で対象のグループを選び、同期実行（ユーザー）を押すと、状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/同期実行（ユーザー）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^成功$",
      "timeoutSec": 300
    }
  ]
}
