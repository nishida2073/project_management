{
  "name": "2.7-10 テンプレートのフォルダを変えて保存を押すと、変えた値が保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/テンプレートのフォルダ",
      "value": "saved-template"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/保存"
    },
    {
      "action": "expectFileContains",
      "path": "bats/common.bat",
      "contains": "TemplateRootDir=saved-template"
    }
  ]
}
