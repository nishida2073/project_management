{
  "name": "2.7-27 環境設定（共通）のアプリデータ集計の列定義で、行を選んで削除を押すと、選んだ行が削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/アプリデータ集計の列定義の削除"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/列定義（13行目）の変更後",
      "pattern": "^パルスサーベイフリーコメント$",
      "absent": true,
      "timeoutSec": 15
    }
  ]
}
