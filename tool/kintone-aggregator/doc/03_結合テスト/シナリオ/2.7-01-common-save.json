{
  "name": "2.7-01 環境設定（共通）で基本設定の値を変えて保存を押すと、変えた値が保存され、画面の表示が更新される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 145,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 35,
      "y": 80
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 261,
      "value": "%BASE_PATH%clients_test"
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 131
    },
    {
      "action": "expectTextAt",
      "x": 200,
      "y": 131,
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "bats/common.bat",
      "contains": "clients_test"
    }
  ]
}
