{
  "name": "2.8-26 対象アプリID（パルスサーベイ） を変えて再読込を押すと、保存されている値に戻る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/対象アプリID（パルスサーベイ）",
      "value": "tmp-reload"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象アプリID（パルスサーベイ）",
      "pattern": "^{{PulseTargetAppIdsRe}}$",
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ],
  "fixtureVars": {
    "PulseTargetAppIds": "PulseTargetAppIds"
  }
}
