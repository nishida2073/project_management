{
  "name": "2.7-02 環境設定（共通）で値を変えたあと再読込を押すと、保存されている値で表示し直され、変えた内容は消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 145,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 35,
      "y": 80
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 261,
      "value": "%BASE_PATH%clients_tmp"
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 169
    },
    {
      "action": "expectTextAt",
      "x": 200,
      "y": 169,
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectEditNotContains",
      "text": "clients_tmp",
      "timeoutSec": 60
    }
  ]
}
