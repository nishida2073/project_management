{
  "name": "2.7-02 環境設定（共通）で値を変えたあと再読込を押すと、保存されている値で表示し直され、変えた内容は消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "pasteAt",
      "part": "環境設定（共通）/基本設定",
      "value": "%BASE_PATH%clients_tmp"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/再読込の状態",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectEditNotContains",
      "text": "clients_tmp",
      "timeoutSec": 60
    }
  ]
}
