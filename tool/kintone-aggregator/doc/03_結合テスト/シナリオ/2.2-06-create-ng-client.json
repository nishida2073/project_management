{
  "name": "2.2-06 異常のクライアント（ng）でアプリデータ作成の業務日誌を実行すると、状態に失敗と表示される",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 138,
      "y": 79
    },
    {
      "action": "typeAt",
      "x": 328,
      "y": 143,
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "x": 726,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 184
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
