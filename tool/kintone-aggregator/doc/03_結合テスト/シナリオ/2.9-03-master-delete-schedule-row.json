{
  "name": "2.9-03 環境設定（マスター）で削除（スケジュールの1行目）を押すと、その行が表から消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/削除（スケジュールの1行目）"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの科目名（1行目）",
      "pattern": "^社会を支えるITサービス$",
      "absent": true,
      "timeoutSec": 10
    },
    {
      "action": "shot"
    }
  ]
}
