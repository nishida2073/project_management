{
  "name": "2.2-02 アプリデータ作成の業務日誌の実行が終わったあと、開くを押すと、作成したデータのフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（業務日誌）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（業務日誌）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（業務日誌）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/開く（業務日誌）"
    },
    {
      "action": "expectWindow",
      "title": "01_提出状況",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "01_提出状況",
      "keys": "%{F4}"
    }
  ]
}
