{
  "name": "2.9-01 環境設定（マスター）のスケジュールの表で行を選んで削除を押すと、選んだ行が削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/スケジュールの1行目の削除"
    },
    {
      "action": "expectTextGone",
      "text": "1",
      "timeoutSec": 10
    }
  ]
}
