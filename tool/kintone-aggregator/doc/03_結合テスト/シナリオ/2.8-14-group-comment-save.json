{
  "name": "2.8-14 投稿コメント文言 を変えて保存を押すと、変えた値が設定ファイルに保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/投稿コメント文言",
      "value": "saved-comment"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "clients/ok.bat",
      "contains": "CommentTextTemplate=saved-comment"
    }
  ]
}
