{
  "name": "2.2-03 アプリデータ作成のパルスサーベイで、対象日と対象のグループを入力して実行すると、状態が成功または警告になり、集計用データが作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（パルスサーベイ）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（パルスサーベイ）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（パルスサーベイ）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（アプリデータ作成）/状態（パルスサーベイ）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "output/01_提出状況/2026-09-01/ok-パルスサーベイ.txt",
      "exists": true
    }
  ]
}
