{
  "name": "2.2-07 異常のクライアント（ng）でアプリデータ作成のパルスサーベイを実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（パルスサーベイ）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（パルスサーベイ）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（パルスサーベイ）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（アプリデータ作成）/状態（パルスサーベイ）",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
