{
  "name": "2.2-07 異常のクライアント（ng）でアプリデータ作成のパルスサーベイを実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 138,
      "y": 79
    },
    {
      "action": "typeAt",
      "x": 328,
      "y": 268,
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "x": 726,
      "y": 269,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 309
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
