    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（業務日誌）"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextAt",
      "part": "実行（アプリデータ作成）/状態（業務日誌）",
