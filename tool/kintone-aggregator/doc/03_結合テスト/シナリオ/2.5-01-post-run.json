{
  "name": "2.5-01 投稿で、対象日と対象のグループを入力して実行すると、状態が成功または警告になり、投稿先のスレッドにコメントが投稿される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
