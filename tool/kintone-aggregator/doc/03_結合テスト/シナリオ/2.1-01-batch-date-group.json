{
  "name": "2.1-01 一括実行が終わると、処理ごとの状態が成功または警告になり、集計用データのファイルが作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アプリデータ作成-パルスサーベイ",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アプリデータ集計-業務日誌・パルスサーベイ",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アラート集計-業務日誌・パルスサーベイ",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アラート集計-投稿",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/対象日",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（一括実行）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌の状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-パルスサーベイの状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ集計-業務日誌・パルスサーベイの状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アラート集計-業務日誌・パルスサーベイの状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アラート集計-投稿の状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "output/01_提出状況/2026-09-01/ok-業務日誌.txt",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "output/01_提出状況/2026-09-01/ok-パルスサーベイ.txt",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "output/02_アプリデータ集計/ok-2026-09-01.txt",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "output/03_アラート検知結果/ok.xlsx",
      "exists": true
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（一括実行）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
