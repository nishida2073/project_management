{
  "name": "2.3-02 アプリデータ集計の実行が終わったあと、開くを押すと、統合したデータのフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "output/01_提出状況/2026-09-01"
    },
    {
      "action": "writeFile",
      "path": "output/01_提出状況/2026-09-01/{{client}}-業務日誌.txt",
      "text": "除外対象\t提出状況\t通番\t会社名\t受講生ID\t氏名\tクラス名\t日付\t本日の理解度\r\nFALSE\tTRUE\t1\tテスト会社\tS001\tテスト太郎\tok\t2026-09-01\t3",
      "encoding": "UTF8"
    },
    {
      "action": "writeFile",
      "path": "output/01_提出状況/2026-09-01/{{client}}-パルスサーベイ.txt",
      "text": "提出状況\t聞きたいことや困ったことがあったときに、気軽に相談できる相手（グループのメンバー、講師、事務局等）や環境はありましたか？\t心身の調子はいかがですか？\t気になること、相談したいこと等ありましたら自由に記入してください。\r\nTRUE\t3\t3\t",
      "encoding": "UTF8"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ集計タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ集計）/対象日",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ集計）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ集計）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（アプリデータ集計）/状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ集計）/開く"
    },
    {
      "action": "expectWindow",
      "title": "02_アプリデータ集計",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "02_アプリデータ集計",
      "keys": "%{F4}"
    }
  ]
}
