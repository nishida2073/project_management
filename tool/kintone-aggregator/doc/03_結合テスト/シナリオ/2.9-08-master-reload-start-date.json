{
  "name": "2.9-08 環境設定（マスター）で開始日を変えたあと再読込を押すと、保存されている値で表示し直され、変えた内容は消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "環境設定（マスター）/スケジュールの開始日（1行目）",
      "value": "tmp-reload"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの開始日（1行目）",
      "pattern": "^2026-09-01$",
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ]
}
