{
  "name": "2.8-34 環境設定（グループ別）で業務日誌の対象アプリIDを空にして、テスト接続（業務日誌）を押すと、メッセージが表示され、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/対象アプリID（業務日誌）",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（業務日誌）"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（業務日誌）",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectMessage",
      "window": "エラー",
      "contains": "対象アプリIDを入力してください"
    }
  ]
}
