{
  "name": "2.7-26 環境設定（共通）のアプリデータ集計の列定義で追加を押すと、表の末尾に空の行が追加される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/アプリデータ集計の列定義の追加"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/列定義（14行目）の変更前",
      "value": "saved-col"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "bats/collect-data-defs.json",
      "contains": "\"orgName\":  \"saved-col\""
    }
  ]
}
