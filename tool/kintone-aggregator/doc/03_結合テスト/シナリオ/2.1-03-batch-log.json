{
  "name": "2.1-03 一括実行が終わると、ログ欄に実行結果が表示され、ログの出力先に実行ログが保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/対象日",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectEditContains",
      "text": "一括実行 完了",
      "timeoutSec": 900
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌の状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-パルスサーベイの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ集計-業務日誌・パルスサーベイの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アラート集計-業務日誌・パルスサーベイの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アラート集計-投稿の状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "logs",
      "exists": true
    }
  ]
}
