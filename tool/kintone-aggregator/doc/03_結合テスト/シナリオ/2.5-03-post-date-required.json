{
  "name": "2.5-03 投稿で、対象日を空にして実行すると、「対象日 を設定してください」と表示され",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アラート集計タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アラート集計）/対象日（投稿）",
      "value": ""
    },
    {
      "action": "selectComboAt",
      "part": "実行（アラート集計）/対象のグループ（投稿）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アラート集計）/実行（投稿）"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "対象日 を設定してください"
    }
  ]
}
