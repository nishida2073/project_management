{
  "name": "2.7-20 業務日誌の日付フィールドコードを変えて再読込を押すと、保存されている値に戻る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wheelAt",
      "x": 300,
      "y": 500,
      "delta": -240
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/業務日誌の日付フィールドコード",
      "value": "tmp-reload"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/業務日誌の日付フィールドコード",
      "pattern": "^{{TargetDateCodeFieldDailyRe}}$",
      "timeoutSec": 15
    }
  ],
  "fixtureVars": {
    "TargetDateCodeFieldDaily": "TargetDateCodeFieldDaily"
  },
  "fixtureFile": "bats\\common.bat"
}
