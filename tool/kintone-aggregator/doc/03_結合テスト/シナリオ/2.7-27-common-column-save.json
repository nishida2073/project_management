{
  "name": "2.7-27 環境設定（共通）のアプリデータ集計の列定義で行を削除して保存を押すと、削除した行が集計データの列定義に保存されない",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/アプリデータ集計の列定義の削除"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileNotContains",
      "path": "bats/collect-data-defs.json",
      "contains": "パルスサーベイフリーコメント"
    },
    {
      "action": "shot"
    }
  ]
}
