{
  "name": "2.9-02 環境設定（マスター）で科目名などを変えて保存を押すと、値が保存され、画面の表示が更新される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "環境設定（マスター）/スケジュールの科目名（1行目）",
      "value": "テスト科目"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/保存"
    },
    {
      "action": "expectEditContains",
      "text": "テスト科目"
    }
  ]
}
