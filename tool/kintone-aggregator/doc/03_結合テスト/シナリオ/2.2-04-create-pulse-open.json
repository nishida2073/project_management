{
  "name": "2.2-04 アプリデータ作成のパルスサーベイの実行が終わったあと、開くを押すと、作成したデータのフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（パルスサーベイ）",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（パルスサーベイ）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（パルスサーベイ）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（アプリデータ作成）/状態（パルスサーベイ）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/開く（パルスサーベイ）"
    },
    {
      "action": "expectWindow",
      "title": "01_提出状況",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "01_提出状況",
      "keys": "%{F4}"
    }
  ]
}
