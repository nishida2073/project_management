{
  "name": "2.3-03 アプリデータ集計で、対象日を空にして実行すると、「対象日 を設定してください」と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ集計タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ集計）/対象日",
      "value": ""
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ集計）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ集計）/実行"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "対象日 を設定してください"
    },
    {
      "action": "shot"
    }
  ]
}
