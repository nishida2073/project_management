{
  "name": "2.7-05 環境設定（共通）のアプリデータ集計の列定義で行を削除して保存を押すと、列定義ファイルに保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/アプリデータ集計の列定義の削除"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/保存の状態",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileNotContains",
      "path": "bats/collect-data-defs.json",
      "contains": "パルスサーベイフリーコメント"
    }
  ]
}
