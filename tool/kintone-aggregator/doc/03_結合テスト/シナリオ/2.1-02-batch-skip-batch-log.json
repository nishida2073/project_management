{
  "name": "2.1-02 一括実行で業務日誌のチェックを外して実行すると、業務日誌はスキップになり、ほかの処理は実行される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/対象日",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌"
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アプリデータ作成-パルスサーベイ",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アプリデータ集計-業務日誌・パルスサーベイ",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アラート集計-業務日誌・パルスサーベイ",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/アラート集計-投稿",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-パルスサーベイの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ集計-業務日誌・パルスサーベイの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アラート集計-業務日誌・パルスサーベイの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アラート集計-投稿の状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌の状態",
      "pattern": "^スキップ$",
      "timeoutSec": 60
    }
  ]
}
