{
  "name": "2.6-03 ログのファイルがある状態で、すべて削除を押し、確認で「はい」を選ぶと、ログのファイルがすべて削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/test.log",
      "text": "test"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 530,
      "y": 103
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "y"
    },
    {
      "action": "expectFile",
      "path": "logs/test.log",
      "exists": false
    }
  ]
}
