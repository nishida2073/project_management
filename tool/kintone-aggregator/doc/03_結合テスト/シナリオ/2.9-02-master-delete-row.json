{
  "name": "2.9-02 環境設定（マスター）のスケジュールの表で行を選んで削除を押すと、選んだ行が削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/スケジュールの1行目の削除"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの科目名（1行目）",
      "pattern": "^社会を支えるITサービス$",
      "absent": true,
      "timeoutSec": 10
    }
  ]
}
