{
  "name": "2.9-02 環境設定（マスター）のスケジュールの1行目を削除して保存すると、Excel の1行目の科目名が消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/スケジュールの1行目の削除"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの科目名（1行目）",
      "pattern": "^社会を支えるITサービス$",
      "absent": true,
      "timeoutSec": 10
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "excelExpect",
      "path": "clients/ok.xlsx",
      "sheet": "スケジュール",
      "cell": "B2",
      "equals": ""
    },
    {
      "action": "shot"
    }
  ]
}
