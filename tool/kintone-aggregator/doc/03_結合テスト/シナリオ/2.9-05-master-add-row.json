{
  "name": "2.9-05 環境設定（マスター）のスケジュールの表で追加を押すと、表の末尾に空の行が追加される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/スケジュールの追加"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/スケジュールの通番（2行目）",
      "pattern": "^2$",
      "timeoutSec": 30
    }
  ]
}
