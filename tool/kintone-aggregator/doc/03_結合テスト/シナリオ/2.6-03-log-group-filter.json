{
  "name": "2.6-03 ログの対象のグループを、すべて・ok・ng と切り替えると、選んだグループの実行ログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/create-daily-report-ok-2026-09-01_20261021_000000.log",
      "text": "create-daily-report-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/create-daily-report-ng-2026-09-01_20261021_000000.log",
      "text": "create-daily-report-ng"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "ng"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create\\-daily\\-report\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    }
  ]
}
