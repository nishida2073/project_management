{
  "name": "2.8-13 環境設定（グループ別）で投稿先スペースIDを空にして、テスト投稿を押すと、状態が失敗になり、投稿は行われない",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": 3000
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/投稿先",
      "value": ""
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": 120
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": 120
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト投稿（投稿先）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 60
    }
  ]
}
