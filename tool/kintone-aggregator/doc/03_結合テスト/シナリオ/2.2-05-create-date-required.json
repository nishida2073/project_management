{
  "name": "2.2-05 アプリデータ作成の業務日誌で、対象日を空にして実行すると、「対象日 を設定してください」と表示され、処理は実行されない",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/アプリデータ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（アプリデータ作成）/対象日（業務日誌）",
      "value": ""
    },
    {
      "action": "selectComboAt",
      "part": "実行（アプリデータ作成）/対象のグループ（業務日誌）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（アプリデータ作成）/実行（業務日誌）"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "対象日 を設定してください"
    }
  ]
}
