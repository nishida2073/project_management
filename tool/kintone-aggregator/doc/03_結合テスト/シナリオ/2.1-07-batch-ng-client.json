{
  "name": "2.1-07 異常のクライアント（ng）で一括実行すると、業務日誌の状態に失敗と表示され、後続の処理は実行される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "typeAt",
      "x": 328,
      "y": 143,
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "x": 726,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 366
    },
    {
      "action": "expectEditContains",
      "text": "一括実行 完了",
      "timeoutSec": 900
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 183,
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 216,
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    }
  ]
}
