{
  "name": "2.1-07 異常のクライアント（ng）で一括実行すると、業務日誌の状態に失敗と表示され、後続の処理は実行される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/対象日",
      "value": "2026-09-01"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-業務日誌の状態",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/アプリデータ作成-パルスサーベイの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    }
  ]
}
