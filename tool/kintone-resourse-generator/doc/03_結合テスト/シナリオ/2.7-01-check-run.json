{
  "name": "2.7-01 スペース確認で実行すると、状態が成功になり、チェック結果の Excel が作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペースダウンロード）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペースID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペースダウンロード）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペースダウンロード）/状態",
      "pattern": "^成功$",
      "timeoutSec": 300
    },
    {
      "action": "clickAt",
      "part": "実行/設定ファイル作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（設定ファイル作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（設定ファイル作成）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "keysAt",
      "part": "実行（設定ファイル作成）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（設定ファイル作成）/状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 300
    },
    {
      "action": "clickAt",
      "part": "実行/スペース確認タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース確認）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース確認）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース確認）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペース確認）/状態",
      "pattern": "^成功$",
      "timeoutSec": 300
    },
    {
      "action": "expectFile",
      "path": "checked/TestSpace_check.xlsx",
      "exists": true
    },
    {
      "action": "shot"
    }
  ]
}
