{
  "name": "2.2-06 一括実行で、スペーステンプレートIDが空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペース識別名",
      "value": "TestId"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（隠した状態）"
    },
    {
      "action": "expectMessage",
      "window": "一括実行",
      "contains": "スペーステンプレートID を設定してください"
    }
  ]
}
