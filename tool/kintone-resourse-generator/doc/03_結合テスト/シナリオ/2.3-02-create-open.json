{
  "name": "2.3-02 スペース作成の開くを押すと、作成したスペースの kintone の画面が開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/スペース作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース作成）/スペース識別名",
      "value": "createok"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース作成）/スペーステンプレートID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペース作成）/状態",
      "pattern": "^成功$",
      "timeoutSec": 900
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（スペース作成）/開く"
    },
    {
      "action": "expectWindow",
      "title": "createok",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "createok",
      "keys": "^w"
    }
  ]
}
