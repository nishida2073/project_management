{
  "name": "2.9-02 共通の環境設定で変えた値を再読込すると、保存されている値に戻る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/共通タブ"
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/ダウンロード先のフォルダ",
      "value": "tmp"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/ダウンロード先のフォルダ",
      "pattern": "^%BASE_PATH%download$",
      "timeoutSec": 30
    }
  ]
}
