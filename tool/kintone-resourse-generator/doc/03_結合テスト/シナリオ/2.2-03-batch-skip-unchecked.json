{
  "name": "2.2-03 一括実行で、チェックを外した処理はスキップと表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペース識別名",
      "value": "skipok"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペーステンプレートID",
      "value": "3"
    },
    {
      "action": "keysAt",
      "part": "実行（一括実行）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/表示／隠す"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/スペースの作成（ラベル）"
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースの作成",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースのダウンロード",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/設定ファイルの作成",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースの更新",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースの確認",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/スペースの作成の状態",
      "pattern": "^スキップ$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/スペースのダウンロードの状態",
      "pattern": "^(成功|失敗)$",
      "timeoutSec": 60
    }
  ]
}
