{
  "name": "2.8-02 ログの削除の確認で「いいえ」を選ぶと、ログは残る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok_20260101_000000.log",
      "text": "LOG_MARKER\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "{TAB}{ENTER}"
    },
    {
      "action": "expectFile",
      "path": "logs/create-space-from-template-ok_20260101_000000.log",
      "exists": true
    }
  ]
}
