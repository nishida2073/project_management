{
  "name": "2.7-04 異常のクライアント（ng）でスペース確認を実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/スペース確認タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース確認）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース確認）/スペース識別名",
      "value": "chkng"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース確認）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペース確認）/状態",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
