{
  "name": "2.7-04 異常のクライアント（ng）でスペース確認を実行すると、状態に失敗と表示される",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 637,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 360,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "x": 360,
      "y": 181,
      "value": "chkng"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 221
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
