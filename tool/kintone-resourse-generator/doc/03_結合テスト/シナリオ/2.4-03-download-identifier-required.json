{
  "name": "2.4-03 スペースダウンロードで、スペース識別名が空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペースダウンロード）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（スペースダウンロード）/実行（スペースのダウンロード）"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "スペース識別名 を設定してください。"
    },
    {
      "action": "shot"
    }
  ]
}
