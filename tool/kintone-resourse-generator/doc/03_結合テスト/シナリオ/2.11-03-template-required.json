{
  "name": "2.11-03 テンプレート作成で、必須の入力が空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/テンプレートタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（テンプレート）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（テンプレート）/実行（テンプレート作成）"
    },
    {
      "action": "expectMessage",
      "window": "テンプレート作成",
      "contains": "対象のグループ、スペースID、テンプレート名を入力してください。"
    },
    {
      "action": "shot"
    }
  ]
}
