{
  "name": "2.1-05 複数実行で、スペース識別名が空の行はスキップされる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\skip-identifier.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行（複数実行）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（複数実行）/状態（複数実行）",
      "pattern": "^終了（成功-0件、警告-0件、失敗/スキップ-1件）$",
      "tolX": 150,
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
