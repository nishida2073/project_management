{
  "name": "2.5-05 異常のクライアント（ng）で設定ファイル作成を実行すると、状態に失敗と表示される",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 440,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 360,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "x": 360,
      "y": 181,
      "value": "cfgng"
    },
    {
      "action": "keysAt",
      "x": 360,
      "y": 218,
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 296
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
