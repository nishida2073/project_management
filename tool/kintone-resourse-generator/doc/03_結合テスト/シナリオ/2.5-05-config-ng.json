{
  "name": "2.5-05 異常のクライアント（ng）で設定ファイル作成を実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/設定ファイル作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（設定ファイル作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（設定ファイル作成）/スペース識別名",
      "value": "cfgng"
    },
    {
      "action": "keysAt",
      "part": "実行（設定ファイル作成）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
