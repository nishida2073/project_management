{
  "name": "2.4-01 スペースダウンロードで実行すると、状態が成功になり、ダウンロード結果の Excel が作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペースダウンロード）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペース識別名",
      "value": "dlok"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペースID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペースダウンロード）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペースダウンロード）/状態",
      "pattern": "^成功$",
      "timeoutSec": 300
    },
    {
      "action": "expectFile",
      "path": "download/dlok_download.xlsx",
      "exists": true
    }
  ]
}
