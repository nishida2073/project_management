{
  "name": "2.2-07 一括実行で、設定テンプレートを両方とも選ばないと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペーステンプレートID",
      "value": "TmplId"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（隠した状態）"
    },
    {
      "action": "expectMessage",
      "window": "一括実行",
      "contains": "設定テンプレート名（基本）または設定テンプレート名（カスタム）のどちらかを指定してください"
    }
  ]
}
