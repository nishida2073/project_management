{
  "name": "2.1-06 異常のクライアント（ng）の行がある実行一覧で実行すると、ng の行は失敗し、ログ欄に終了が表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\ng.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行"
    },
    {
      "action": "expectEditContains",
      "text": "終了（",
      "timeoutSec": 900
    },
    {
      "action": "expectEditContains",
      "text": ": 失敗",
      "timeoutSec": 15
    }
  ]
}
