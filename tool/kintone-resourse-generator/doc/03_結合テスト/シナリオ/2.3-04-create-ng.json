{
  "name": "2.3-04 異常のクライアント（ng）でスペースの作成を実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/スペース作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース作成）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース作成）/スペーステンプレートID",
      "value": "2"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペース作成）/状態",
      "pattern": "^失敗$",
      "timeoutSec": 900
    },
    {
      "action": "shot"
    }
  ]
}
