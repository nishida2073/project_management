{
  "name": "2.2-04 一括実行の開くを押すと、対象の画面またはExcelが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペーステンプレートID",
      "value": "3"
    },
    {
      "action": "keysAt",
      "part": "実行（一括実行）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/表示／隠す"
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースの作成",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースのダウンロード",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/設定ファイルの作成",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースの更新",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/スペースの確認",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（一括実行）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（スペースの作成）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "waitDoneAt",
      "part": "実行（一括実行）/状態（一括実行）",
      "timeoutSec": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（スペースの作成）"
    },
    {
      "action": "expectWindow",
      "title": "TestSpace",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "TestSpace",
      "keys": "^w"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（スペースのダウンロード）"
    },
    {
      "action": "expectWindow",
      "title": "TestSpace_download",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "TestSpace_download"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（設定ファイルの作成）"
    },
    {
      "action": "expectWindow",
      "title": "TestSpace_config",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "TestSpace_config"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（スペースの更新）"
    },
    {
      "action": "expectWindow",
      "title": "TestSpace",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "TestSpace",
      "keys": "^w"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（スペースの確認）"
    },
    {
      "action": "expectWindow",
      "title": "TestSpace_check",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "TestSpace_check"
    },
    {
      "action": "shot"
    }
  ]
}
