{
  "name": "2.2-04 一括実行が終わると、各処理の状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペーステンプレートID",
      "value": "3"
    },
    {
      "action": "keysAt",
      "part": "実行（一括実行）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/表示／隠す"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（スペースの作成）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（スペースのダウンロード）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（設定ファイルの作成）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（スペースの更新）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（スペースの確認）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectLogFile",
      "path": "logs",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態",
      "pattern": "^成功$",
      "timeoutSec": 900
    }
  ]
}
