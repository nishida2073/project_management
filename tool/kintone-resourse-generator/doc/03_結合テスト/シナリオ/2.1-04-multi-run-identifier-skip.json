{
  "name": "2.1-04 複数実行で、スペース識別名が空の行はスキップされる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 360,
      "y": 142,
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "x": 360,
      "y": 181,
      "value": "{{root}}\\run-list\\skip-identifier.xlsx"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 221
    },
    {
      "action": "expectEditContains",
      "text": "スペース識別名が空のためスキップします",
      "timeoutSec": 60
    }
  ]
}
