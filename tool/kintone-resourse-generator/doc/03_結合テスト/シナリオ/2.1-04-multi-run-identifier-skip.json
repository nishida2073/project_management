{
  "name": "2.1-04 複数実行で、スペース識別名が空の行はスキップされる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\skip-identifier.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行"
    },
    {
      "action": "expectEditContains",
      "text": "スペース識別名が空のためスキップします",
      "timeoutSec": 60
    }
  ]
}
