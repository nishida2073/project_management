{
  "name": "2.1-02 複数実行が終わると、実行結果がログ欄に表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\ok.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行"
    },
    {
      "action": "expectEditContains",
      "text": "終了（",
      "timeoutSec": 900
    },
    {
      "action": "expectLogFile",
      "path": "logs",
      "timeoutSec": 30
    }
  ]
}
