{
  "name": "2.10-05 保存済みのグループをコピーすると、設定ファイルができる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "KrgCopy"
    },
    {
      "action": "expectFile",
      "path": "clients/KrgCopy.bat",
      "exists": true
    },
    {
      "action": "expectText",
      "text": "KrgCopy"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "pattern": "^KrgCopy$",
      "timeoutSec": 15
    }
  ]
}
