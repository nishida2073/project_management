{
  "name": "2.8-04 ログの対象のグループで すべてを選ぶと両方のログが表示され、okを選ぶとokのログだけが表示される",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-ok_20260101_000000.log",
      "text": "LOG_OK_OK\r\n"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-ng_20260101_000000.log",
      "text": "LOG_NG_NG\r\n"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ok-ok_20260101_000000.log",
      "text": "LOG_DL_OK\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "selectComboAt",
      "x": 355,
      "y": 103,
      "value": ""
    },
    {
      "action": "expectEditContains",
      "text": "LOG_OK_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "LOG_NG_NG",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "x": 355,
      "y": 103,
      "value": "{{client}}"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_OK_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_NG_NG",
      "timeoutSec": 30
    }
  ]
}
