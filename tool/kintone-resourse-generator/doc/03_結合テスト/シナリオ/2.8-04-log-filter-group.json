{
  "name": "2.8-04 ログの対象のグループで「すべて」「ok」「ng」を切り替えると、選んだグループのログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-config1_20260101_000000.log",
      "text": "create-space-from-template-ok-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-config2_20260101_000000.log",
      "text": "create-space-from-template-ok-config2"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-config1_20260101_000000.log",
      "text": "create-space-from-template-ng-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-config2_20260101_000000.log",
      "text": "create-space-from-template-ng-config2"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ok-config1_20260101_000000.log",
      "text": "download-kintone-resources-ok-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ok-config2_20260101_000000.log",
      "text": "download-kintone-resources-ok-config2"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ng-config1_20260101_000000.log",
      "text": "download-kintone-resources-ng-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ng-config2_20260101_000000.log",
      "text": "download-kintone-resources-ng-config2"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "ログ/スペースのダウンロード"
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ok-config1",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ok-config2",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ng-config1",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ng-config2",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "ok"
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ok-config1",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ok-config2",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "download-kintone-resources-ng-config1",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "download-kintone-resources-ng-config2",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "ng"
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ng-config1",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "download-kintone-resources-ng-config2",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "download-kintone-resources-ok-config1",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "download-kintone-resources-ok-config2",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    }
  ]
}
