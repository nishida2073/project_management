{
  "name": "2.1-05 複数実行が終わると、実行結果がログ欄に表示され、ログの出力先に実行ログが保存される",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 360,
      "y": 142,
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "x": 360,
      "y": 181,
      "value": "{{root}}\\run-list\\ok.xlsx"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 221
    },
    {
      "action": "expectEditContains",
      "text": "終了（",
      "timeoutSec": 900
    },
    {
      "action": "expectLogFile",
      "path": "logs",
      "timeoutSec": 30
    }
  ]
}
