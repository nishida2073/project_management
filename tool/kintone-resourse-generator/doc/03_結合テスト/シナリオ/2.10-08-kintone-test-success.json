{
  "name": "2.10-08 kintone接続のテスト接続で、正しい接続情報なら成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続"
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 60
    }
  ]
}
