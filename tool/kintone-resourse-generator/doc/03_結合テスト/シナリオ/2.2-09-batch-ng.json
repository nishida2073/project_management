{
  "name": "2.2-09 異常のクライアント（ng）で一括実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペース識別名",
      "value": "ngtest"
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/スペーステンプレートID",
      "value": "3"
    },
    {
      "action": "keysAt",
      "part": "実行（一括実行）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/表示／隠す"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
