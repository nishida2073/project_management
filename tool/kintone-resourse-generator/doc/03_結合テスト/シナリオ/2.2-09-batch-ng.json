{
  "name": "2.2-09 異常のクライアント（ng）で一括実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 120,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 360,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "x": 360,
      "y": 181,
      "value": "ngtest"
    },
    {
      "action": "typeAt",
      "x": 360,
      "y": 218,
      "value": "3"
    },
    {
      "action": "keysAt",
      "x": 360,
      "y": 256,
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "x": 58,
      "y": 339
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 548
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
