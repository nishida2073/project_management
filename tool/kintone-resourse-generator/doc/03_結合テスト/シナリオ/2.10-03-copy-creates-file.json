{
  "name": "2.10-03 保存済みのグループをコピーすると、設定ファイルができる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "TestCopy"
    },
    {
      "action": "expectFile",
      "path": "clients/TestCopy.bat",
      "exists": true
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "pattern": "^TestCopy$",
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ]
}
