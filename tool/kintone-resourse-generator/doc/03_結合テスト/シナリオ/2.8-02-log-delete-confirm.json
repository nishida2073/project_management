{
  "name": "2.8-02 ログの削除の確認で「はい」を選ぶと、ログが削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-config1_20260101_000000.log",
      "text": "create-space-from-template-ok-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-config2_20260101_000000.log",
      "text": "create-space-from-template-ok-config2"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-config1_20260101_000000.log",
      "text": "create-space-from-template-ng-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-config2_20260101_000000.log",
      "text": "create-space-from-template-ng-config2"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "selectComboAt",
      "part": "ログ/スペース識別名（ログの絞り込み）",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "y"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create-space-from-template-ok-config1",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "create-space-from-template-ng-config1",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    }
  ]
}
