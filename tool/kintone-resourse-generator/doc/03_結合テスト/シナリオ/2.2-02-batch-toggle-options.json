{
  "name": "2.2-02 一括実行の表示／隠すを押すと、処理の選択欄が隠れたり表示されたりする",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/表示／隠す"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/表示／隠す",
      "pattern": "^隠す$",
      "timeoutSec": 5
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/表示／隠す"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/表示／隠す",
      "pattern": "^表示$",
      "timeoutSec": 5
    }
  ]
}
