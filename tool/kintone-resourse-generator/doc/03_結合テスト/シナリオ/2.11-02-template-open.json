{
  "name": "2.11-02 テンプレート作成の開くを押すと、テンプレートのファイルが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/テンプレートタブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（テンプレート）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（テンプレート）/スペースID",
      "value": "3"
    },
    {
      "action": "typeAt",
      "part": "環境設定（テンプレート）/テンプレート名",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（テンプレート）/実行"
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 120
    },
    {
      "action": "clickAt",
      "part": "環境設定（テンプレート）/開く"
    },
    {
      "action": "expectWindow",
      "title": "{{client}}_{{client}}",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "{{client}}_{{client}}"
    }
  ]
}
