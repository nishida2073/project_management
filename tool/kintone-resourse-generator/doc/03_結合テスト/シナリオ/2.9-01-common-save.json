{
  "name": "2.9-01 共通の環境設定でダウンロード先を変えて保存すると、設定ファイルに保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/共通タブ"
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/ダウンロード先のフォルダ",
      "value": "%BASE_PATH%download2"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "bats/common.bat",
      "contains": "download2"
    }
  ]
}
