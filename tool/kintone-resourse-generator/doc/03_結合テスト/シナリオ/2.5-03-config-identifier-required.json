{
  "name": "2.5-03 設定ファイル作成で、スペース識別名が空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/設定ファイル作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（設定ファイル作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/実行"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "スペース識別名 を設定してください"
    }
  ]
}
