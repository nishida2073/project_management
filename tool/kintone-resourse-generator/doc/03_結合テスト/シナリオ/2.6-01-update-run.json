{
  "name": "2.6-01 スペース更新で実行すると、設定ファイルの内容が kintone のスペースに反映され、状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペースダウンロード）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペース識別名",
      "value": "dlok"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペースID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペースダウンロード）/実行"
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 300
    },
    {
      "action": "clickAt",
      "part": "実行/設定ファイル作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（設定ファイル作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（設定ファイル作成）/スペース識別名",
      "value": "dlok"
    },
    {
      "action": "keysAt",
      "part": "実行（設定ファイル作成）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 300
    },
    {
      "action": "clickAt",
      "part": "実行/スペース更新タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース更新）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース更新）/スペース識別名",
      "value": "dlok"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース更新）/実行"
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 300
    }
  ]
}
