{
  "name": "2.10-15 環境設定（グループ別）で再読込を押すと、状態（再読込）が完了になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    }
  ]
}
