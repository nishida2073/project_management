{
  "name": "2.8-06 削除対象のログがないときは、すべて削除でメッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "selectComboAt",
      "part": "ログ/スペース識別名（ログの絞り込み）",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectMessage",
      "window": "ログの削除",
      "contains": "削除対象のログファイルがありません"
    }
  ]
}
