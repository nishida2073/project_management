{
  "name": "2.3-01 スペース作成で、スペーステンプレートを使ってスペースを作成すると、作成したスペースのIDがスペースダウンロードのスペースIDに入る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/スペース作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース作成）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "typeAt",
      "part": "実行（スペース作成）/スペーステンプレートID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペース作成）/状態",
      "pattern": "^成功$",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペースダウンロード）/スペースID",
      "pattern": "^\\d+$",
      "timeoutSec": 30
    }
  ]
}
