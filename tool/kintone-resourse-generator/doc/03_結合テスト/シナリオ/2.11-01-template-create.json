{
  "name": "2.11-01 テンプレート作成で、スペースIDとテンプレート名を入力して実行すると、テンプレートのファイルが作られ、状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/テンプレートタブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（テンプレート）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（テンプレート）/スペースID",
      "value": "3"
    },
    {
      "action": "typeAt",
      "part": "環境設定（テンプレート）/テンプレート名",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（テンプレート）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（テンプレート）/状態",
      "pattern": "^成功$",
      "timeoutSec": 120
    },
    {
      "action": "expectFile",
      "path": "template/custom/{{client}}_{{client}}.xlsx",
      "exists": true
    }
  ]
}
