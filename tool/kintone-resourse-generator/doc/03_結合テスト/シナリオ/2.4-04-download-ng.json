{
  "name": "2.4-04 異常のクライアント（ng）でスペースダウンロードを実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペースダウンロード）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペース識別名",
      "value": "dlng"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペースID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペースダウンロード）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 900
    }
  ]
}
