{
  "name": "2.2-05 一括実行で、スペース識別名が空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（隠した状態）"
    },
    {
      "action": "expectMessage",
      "window": "一括実行",
      "contains": "スペース識別名 を設定してください"
    }
  ]
}
