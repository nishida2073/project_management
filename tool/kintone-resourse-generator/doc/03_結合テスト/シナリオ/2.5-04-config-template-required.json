{
  "name": "2.5-04 設定ファイル作成で、設定テンプレートを両方とも選ばないと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/設定ファイル作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（設定ファイル作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（設定ファイル作成）/スペース識別名",
      "value": "TestSpace"
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/実行（設定ファイルの作成）"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "設定テンプレート名（基本）または設定テンプレート名（カスタム）のどちらかを指定してください。"
    },
    {
      "action": "shot"
    }
  ]
}
