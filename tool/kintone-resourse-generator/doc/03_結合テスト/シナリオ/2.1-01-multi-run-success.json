{
  "name": "2.1-01 複数実行で、実行一覧ファイルを使って実行すると、状態に件数が表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\ok.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（複数実行）/状態",
      "pattern": "^終了（成功-1件、警告-0件、失敗/スキップ-0件）$",
      "tolX": 150,
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "download/TestSpace_download.xlsx",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "config/TestSpace_config.xlsx",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "checked/TestSpace_check.xlsx",
      "exists": true
    },
    {
      "action": "shot"
    }
  ]
}
