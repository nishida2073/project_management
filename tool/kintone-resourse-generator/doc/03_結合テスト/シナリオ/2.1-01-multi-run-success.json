{
  "name": "2.1-01 複数実行で、有効な行があると行ごとに一括実行され、行ごとの結果が表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\ok.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行"
    },
    {
      "action": "expectEditContains",
      "text": "終了（",
      "timeoutSec": 900
    },
    {
      "action": "expectTextAt",
      "part": "実行（複数実行）/状態",
      "pattern": "^終了（成功-1件、警告-0件、失敗/スキップ-1件）$",
      "tolX": 150,
      "timeoutSec": 60
    }
  ]
}
