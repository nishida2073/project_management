{
  "name": "2.8-06 ログの処理のラジオボタンを切り替えると、ラジオボタンごとに選んだ処理のログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-ok_20261021_000000.log",
      "text": "LOG_CREATE_OK"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ok-ok_20261021_000000.log",
      "text": "LOG_DL_OK"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-config-from-template-ok-ok_20261021_000000.log",
      "text": "LOG_CONFIG_OK"
    },
    {
      "action": "writeFile",
      "path": "logs/apply-kintone-resources-ok-ok_20261021_000000.log",
      "text": "LOG_UPDATE_OK"
    },
    {
      "action": "writeFile",
      "path": "logs/check-kintone-resources-ok-ok_20261021_000000.log",
      "text": "LOG_CHECK_OK"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "clickAt",
      "part": "ログ/スペースの作成"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_CREATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_DL_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CONFIG_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_UPDATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CHECK_OK",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "ログ/スペースのダウンロード"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_DL_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CREATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CONFIG_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_UPDATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CHECK_OK",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "ログ/設定ファイルの作成"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_CONFIG_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CREATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_DL_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_UPDATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CHECK_OK",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "ログ/スペースの更新"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_UPDATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CREATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_DL_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CONFIG_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CHECK_OK",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "ログ/スペースの確認"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_CHECK_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CREATE_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_DL_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_CONFIG_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_UPDATE_OK",
      "timeoutSec": 30
    }
  ]
}
