{
  "name": "2.1-07 異常のクライアント（ng）の行がある実行一覧で実行すると、ng の行は失敗し、状態に終了が表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/複数実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（複数実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（複数実行）/実行一覧ファイル",
      "value": "{{root}}\\run-list\\ng.xlsx"
    },
    {
      "action": "clickAt",
      "part": "実行（複数実行）/実行（複数実行）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（複数実行）/状態（複数実行）",
      "pattern": "^終了（成功-0件、警告-0件、失敗/スキップ-[1-9][0-9]*件）$",
      "tolX": 150,
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
