{
  "name": "2.10-16 異常のクライアント（ng）を選び、誤ったパスワードでテスト接続を押すと、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/パスワード",
      "value": "wrong-password"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（認証情報）"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（テスト接続）",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
