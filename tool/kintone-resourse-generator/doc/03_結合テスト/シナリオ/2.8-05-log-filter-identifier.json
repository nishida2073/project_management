{
  "name": "2.8-05 ログのスペース識別名を、すべて・okと切り替えると、選んだ識別名の実行ログだけが表示される",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-ok_20260101_000000.log",
      "text": "LOG_OK_OK\r\n"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-ng_20260101_000000.log",
      "text": "LOG_NG_NG\r\n"
    },
    {
      "action": "writeFile",
      "path": "logs/download-kintone-resources-ok-ok_20260101_000000.log",
      "text": "LOG_DL_OK\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "selectComboAt",
      "x": 355,
      "y": 147,
      "value": ""
    },
    {
      "action": "expectEditContains",
      "text": "LOG_OK_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "LOG_NG_NG",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "x": 355,
      "y": 147,
      "value": "ok"
    },
    {
      "action": "expectEditContains",
      "text": "LOG_OK_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_NG_NG",
      "timeoutSec": 30
    }
  ]
}
