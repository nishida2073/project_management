{
  "name": "2.8-03 ログの削除の確認で「はい」を選ぶと、ログが削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-config1_20260101_000000.log",
      "text": "create-space-from-template-ok-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ok-config2_20260101_000000.log",
      "text": "create-space-from-template-ok-config2"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-config1_20260101_000000.log",
      "text": "create-space-from-template-ng-config1"
    },
    {
      "action": "writeFile",
      "path": "logs/create-space-from-template-ng-config2_20260101_000000.log",
      "text": "create-space-from-template-ng-config2"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "{ENTER}"
    },
    {
      "action": "expectFile",
      "path": "logs/create-space-from-template-ok-config1_20260101_000000.log",
      "exists": false
    },
    {
      "action": "expectFile",
      "path": "logs/create-space-from-template-ok-config2_20260101_000000.log",
      "exists": false
    },
    {
      "action": "expectFile",
      "path": "logs/create-space-from-template-ng-config1_20260101_000000.log",
      "exists": false
    },
    {
      "action": "expectFile",
      "path": "logs/create-space-from-template-ng-config2_20260101_000000.log",
      "exists": false
    }
  ]
}
