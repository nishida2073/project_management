{
  "name": "2.10-10 kintone接続のサブドメインを空にしてテスト接続すると、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/サブドメイン",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（認証情報）"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（認証情報）",
      "pattern": "^失敗$",
      "timeoutSec": 30
    }
  ]
}
