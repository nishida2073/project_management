{
  "name": "2.8-01 削除対象のログがないときは、すべて削除でメッセージが出る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectMessage",
      "window": "ログの削除",
      "contains": "削除対象のログファイルがありません"
    }
  ]
}
