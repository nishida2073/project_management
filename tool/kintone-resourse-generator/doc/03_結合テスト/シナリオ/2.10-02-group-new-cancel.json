{
  "name": "2.10-02 グループの新規作成の入力をキャンセルすると、グループは追加されない",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/新規作成"
    },
    {
      "action": "pressKey",
      "window": "グループの新規作成",
      "key": "{ESC}"
    },
    {
      "action": "expectFile",
      "path": "clients/TestCancel.bat",
      "exists": false
    }
  ]
}
