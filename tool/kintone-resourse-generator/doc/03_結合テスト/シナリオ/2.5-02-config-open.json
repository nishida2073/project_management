{
  "name": "2.5-02 設定ファイル作成の開くを押すと、設定ファイルが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/スペースダウンロードタブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペースダウンロード）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペース識別名",
      "value": "dlok"
    },
    {
      "action": "typeAt",
      "part": "実行（スペースダウンロード）/スペースID",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "実行（スペースダウンロード）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（スペースダウンロード）/状態",
      "pattern": "^成功$",
      "timeoutSec": 300
    },
    {
      "action": "clickAt",
      "part": "実行/設定ファイル作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（設定ファイル作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（設定ファイル作成）/スペース識別名",
      "value": "dlok"
    },
    {
      "action": "keysAt",
      "part": "実行（設定ファイル作成）/設定テンプレート名（基本）",
      "keys": "{DOWN}{ENTER}"
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（設定ファイル作成）/状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 300
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（設定ファイル作成）/開く"
    },
    {
      "action": "expectWindow",
      "title": "dlok_config",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "dlok_config"
    }
  ]
}
