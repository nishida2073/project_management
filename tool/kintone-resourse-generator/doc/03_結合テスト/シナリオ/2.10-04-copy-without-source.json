{
  "name": "2.10-04 まだ保存していないグループはコピーできない",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/グループ別タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/新規作成"
    },
    {
      "action": "enterDialog",
      "window": "グループの新規作成",
      "value": "KrgUnsaved"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/コピー"
    },
    {
      "action": "expectMessage",
      "window": "コピー作成",
      "contains": "コピー元のグループが存在しません"
    },
    {
      "action": "expectFile",
      "path": "clients/KrgUnsaved.bat",
      "exists": false
    }
  ]
}
