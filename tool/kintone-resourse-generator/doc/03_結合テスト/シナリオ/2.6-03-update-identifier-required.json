{
  "name": "2.6-03 スペース更新で、スペース識別名が空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/スペース更新タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（スペース更新）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（スペース更新）/実行"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "スペース識別名 を設定してください"
    }
  ]
}
