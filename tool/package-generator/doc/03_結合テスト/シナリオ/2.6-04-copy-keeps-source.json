{
  "name": "2.6-04 コピーしても、コピー元の設定ファイルと Excel ファイルは残る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "TestCopy"
    },
    {
      "action": "expectFileContains",
      "path": "clients/ok.bat",
      "contains": "{{GenerateOutputPath}}"
    },
    {
      "action": "expectFile",
      "path": "clients/ok.xlsx",
      "exists": true
    }
  ],
  "fixtureVars": {
    "GenerateOutputPath": "GenerateOutputPath"
  }
}
