{
  "name": "2.6-04 コピーすると、新しいグループの設定ファイルと Excel ファイルが作られ、コピー元は変わらない",
  "kind": "正常系",
  "setup": [
    {
      "action": "writeFile",
      "path": "clients/CopySrc.bat",
      "text": "set \"GenerateOutputPath=%BASE_PATH%generated\\CopySrc\"\r\nset \"KintoneSubdomain=univ-kyousai-{x}\"\r\n"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "CopySrc"
    },
    {
      "action": "click",
      "target": "コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "PkgCopy"
    },
    {
      "action": "expectFileContains",
      "path": "clients/CopySrc.bat",
      "contains": "generated\\CopySrc"
    },
    {
      "action": "expectFile",
      "path": "clients/CopySrc.xlsx",
      "exists": true
    }
  ]
}
