{
  "name": "2.3-02 パッケージ反映で、ファイルを指定せずに実行すると、既定の出力先の zip がアップロードされ状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "waitDoneAt",
      "part": "実行（パッケージ作成）/状態",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（パッケージ反映）/タイトル",
      "value": "TestTitle"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "expectLogContains",
      "path": "logs",
      "filter": "upload-kintone-file*.log",
      "contains": "レコードID"
    },
    {
      "action": "shot"
    }
  ]
}
