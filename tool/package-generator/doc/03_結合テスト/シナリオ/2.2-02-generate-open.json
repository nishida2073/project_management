{
  "name": "2.2-02 パッケージ作成の開くを押すと、パッケージの出力先のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行（パッケージの作成）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態（パッケージの作成）",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/開く（パッケージの作成）"
    },
    {
      "action": "expectWindow",
      "title": "{{client}}",
      "timeoutSec": 30
    },
    {
      "action": "closeWindow",
      "title": "{{client}}"
    },
    {
      "action": "shot"
    }
  ]
}
