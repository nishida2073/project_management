{
  "name": "2.6-08 コピーすると、パッケージの出力先の名前が新しいグループの名前になる",
  "setup": [
    {
      "action": "writeFile",
      "path": "clients/CopySrc.bat",
      "text": "set \"GenerateOutputPath=%BASE_PATH%generated\\CopySrc\"\r\nset \"KintoneSubdomain=univ-kyousai-{x}\"\r\n"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 107,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "CopySrc"
    },
    {
      "action": "click",
      "target": "コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "TestDst"
    },
    {
      "action": "expectFileContains",
      "path": "clients/TestDst.bat",
      "contains": "generated\\TestDst"
    }
  ]
}
