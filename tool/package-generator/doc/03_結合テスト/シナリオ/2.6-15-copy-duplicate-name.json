  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 107,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "CopySrc"
    },
    {
      "action": "click",
      "target": "コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "CopySrc"
    },
    {
      "action": "expectMessage",
