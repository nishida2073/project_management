{
  "name": "2.4-06 処理のラジオボタンを切り替えると、ラジオボタンごとに選んだ処理のログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok-ok_20261021_000000.log",
      "text": "LOG_PKG_OK"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-ok_20261021_000000.log",
      "text": "LOG_UPLOAD_OK"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 103,
      "value": "ok"
    },
    {
      "action": "clickAt",
      "x": 110,
      "y": 155
    },
    {
      "action": "expectEditContains",
      "text": "LOG_PKG_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_UPLOAD_OK",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "x": 110,
      "y": 186
    },
    {
      "action": "expectEditContains",
      "text": "LOG_UPLOAD_OK",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_PKG_OK",
      "timeoutSec": 30
    }
  ]
}
