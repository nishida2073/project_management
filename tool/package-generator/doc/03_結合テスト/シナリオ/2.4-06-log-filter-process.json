{
  "name": "2.4-06 処理のラジオボタンを切り替えると、選んだ処理のログだけが表示される",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "text": "LOG_OK_MARKER\r\n"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "text": "LOG_NG_MARKER\r\n"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-460_20260101_000000.log",
      "text": "LOG_UPLOAD_MARKER\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 103,
      "value": "ok"
    },
    {
      "action": "clickAt",
      "x": 40,
      "y": 186
    },
    {
      "action": "expectEditContains",
      "text": "LOG_UPLOAD_MARKER",
      "timeoutSec": 15
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_OK_MARKER"
    },
    {
      "action": "clickAt",
      "x": 40,
      "y": 155
    },
    {
      "action": "expectEditContains",
      "text": "LOG_OK_MARKER",
      "timeoutSec": 15
    },
    {
      "action": "expectEditNotContains",
      "text": "LOG_UPLOAD_MARKER"
    }
  ]
}
