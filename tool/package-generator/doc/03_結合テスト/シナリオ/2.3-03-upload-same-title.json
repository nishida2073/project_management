{
  "name": "2.3-03 同じタイトルでもう一度実行すると、既存のレコードが更新される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/クリア（フォルダ）"
    },
    {
      "action": "typeAt",
      "part": "実行（パッケージ反映）/タイトル",
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "part": "実行（パッケージ反映）/ファイル1",
      "value": "{{root}}\\generated\\ok\\コースA.zip"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/実行"
    },
    {
      "action": "expectLogContains",
      "path": "logs",
      "filter": "upload-kintone-file*.log",
      "contains": "同じタイトルのレコードを更新しました: レコードID"
    }
  ]
}
