{
  "name": "2.2-04 圧縮元のフォルダが存在しない（異常のクライアント）と、状態が警告になる",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態",
      "pattern": "^警告$",
      "timeoutSec": 30
    },
    {
      "action": "shot"
    }
  ]
}
