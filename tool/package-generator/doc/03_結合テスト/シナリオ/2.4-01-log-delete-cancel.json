{
  "name": "2.4-01 ログの削除の確認で「いいえ」を選ぶと、ログは残る",
  "kind": "正常系",
  "vars": {},
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "text": "generate-package-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "text": "generate-package-ng"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-ok_20261021_000000.log",
      "text": "upload-kintone-file-ok-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ng-ng_20261021_000000.log",
      "text": "upload-kintone-file-ng-ng"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "n"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate-package-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate-package-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ]
}
