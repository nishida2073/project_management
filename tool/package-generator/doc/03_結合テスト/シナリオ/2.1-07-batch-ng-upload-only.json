{
  "name": "2.1-07 異常のクライアント（ng）で、パッケージのアップロードだけを一括実行すると、アップロードの状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/パッケージの作成"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/パッケージのアップロード"
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/パッケージの作成",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/パッケージのアップロード（チェック確認）",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージのアップロード）",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
