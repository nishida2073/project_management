{
  "name": "2.2-04 警告のクライアントでパッケージを作成すると、状態が警告になる",
  "kind": "正常系",
  "vars": {
    "client": "warn"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectText",
      "text": "警告",
      "timeoutSec": 60
    }
  ]
}
