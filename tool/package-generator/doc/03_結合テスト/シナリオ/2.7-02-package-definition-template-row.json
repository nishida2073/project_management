{
  "name": "2.7-02 パッケージ定義ファイルの「テンプレート」シートの 2 行目に値があっても、更新すると書き換えられる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "excelWrite",
      "path": "clients/ok.xlsx",
      "sheet": "テンプレート",
      "cell": "A2",
      "value": "MARKER_ROW2"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/パッケージ定義タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（パッケージ定義）/対象のグループ",
      "value": "ok"
    },
    {
      "action": "clickAt",
      "part": "環境設定（パッケージ定義）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（パッケージ定義）/状態",
      "pattern": "^成功$",
      "timeoutSec": 120
    },
    {
      "action": "excelExpect",
      "path": "clients/ok.xlsx",
      "sheet": "テンプレート",
      "cell": "A2",
      "notEquals": "MARKER_ROW2"
    },
    {
      "action": "excelExpect",
      "path": "clients/ok.xlsx",
      "sheet": "テンプレート",
      "cell": "A2",
      "notEquals": ""
    }
  ]
}
