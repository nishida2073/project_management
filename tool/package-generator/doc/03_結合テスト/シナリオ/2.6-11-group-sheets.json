{
  "name": "2.6-11 パッケージ作成の対象のシートに値を入れて保存し、選び直すと値が残る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "ok"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/ログイン名"
    },
    {
      "action": "wheelAt",
      "x": 480,
      "y": 400,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/対象のシート",
      "value": "1,2"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "clients/ok.bat",
      "contains": "GenerateSheetsInclude=1,2"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "ng"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "ok"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象のシート",
      "pattern": "^1,2$",
      "timeoutSec": 30
    }
  ]
}
