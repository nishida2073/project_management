{
  "name": "2.4-03 ログの対象のグループで すべてを選ぶと両方のログが表示され、okを選ぶとokのログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "text": "generate-package-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "text": "generate-package-ng"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-460_20260101_000000.log",
      "text": "upload-kintone-file-ok-460"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ng-460_20260101_000000.log",
      "text": "upload-kintone-file-ng-460"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": "ng"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    }
  ]
}
