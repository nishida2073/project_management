{
  "name": "2.4-04 処理のラジオボタンで「パッケージの作成」を選ぶと、パッケージの作成のログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok-ok_20261021_000000.log",
      "text": "generate-package-ok-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-ok_20261021_000000.log",
      "text": "upload-kintone-file-ok-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng-ng_20261021_000000.log",
      "text": "generate-package-ng-ng"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ng-ng_20261021_000000.log",
      "text": "upload-kintone-file-ng-ng"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "ログ/パッケージの作成（ラジオ）"
    },
    {
      "action": "clickAt",
      "part": "ログ/パッケージのアップロード（ラジオ）"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ok\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "upload\\-kintone\\-file\\-ok\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ng\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "upload\\-kintone\\-file\\-ng\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "part": "ログ/パッケージの作成（ラジオ）"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ok\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "upload\\-kintone\\-file\\-ok\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "generate\\-package\\-ng\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "upload\\-kintone\\-file\\-ng\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "shot"
    }
  ]
}
