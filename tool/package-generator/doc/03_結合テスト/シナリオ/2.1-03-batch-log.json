{
  "name": "2.1-03 一括実行が終わると、実行のログがログの出力先に保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージの作成）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectLogFile",
      "path": "logs"
    }
  ]
}
