{
  "name": "2.3-10 パッケージ反映で、同じ名前の zip ファイルをファイル1とフォルダに指定すると、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 134,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 183
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "x": 238,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 181,
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 255,
      "value": "{{root}}\\generated\\ok\\コースA.zip"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 483
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "同じ名前のzipファイルがあります"
    }
  ]
}
