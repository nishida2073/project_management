{
  "name": "2.5-01 共通の設定でログの出力先を変えて保存すると、設定ファイルに保存される",
  "kind": "正常系",
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 35,
      "y": 79
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 261,
      "value": "%BASE_PATH%logs2"
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 131
    },
    {
      "action": "expectTextAt",
      "x": 200,
      "y": 131,
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "bats/common.bat",
      "contains": "logs2"
    }
  ]
}
