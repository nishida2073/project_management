{
  "name": "2.5-02 共通の設定で変えた値を再読込すると、保存されている値に戻る",
  "kind": "正常系",
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/ログの出力先",
      "value": "tmp"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/ログの出力先",
      "pattern": "^%BASE_PATH%logs$",
      "timeoutSec": 30
    }
  ]
}
