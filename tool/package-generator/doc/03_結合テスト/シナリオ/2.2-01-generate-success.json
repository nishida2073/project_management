{
  "name": "2.2-01 パッケージ作成で実行すると、パッケージが作られ、状態が成功になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "download/test/sample.txt",
      "text": "sample\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行（パッケージの作成）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態（パッケージの作成）",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "generated/ok",
      "exists": true
    },
    {
      "action": "shot"
    }
  ]
}
