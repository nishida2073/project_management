{
  "name": "2.6-02 新規作成したグループは、保存すると設定ファイルと Excel ファイルができる",
  "kind": "正常系",
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "click",
      "target": "新規作成"
    },
    {
      "action": "enterDialog",
      "window": "グループの新規作成",
      "value": "PkgNew"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/保存の状態",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFile",
      "path": "clients/PkgNew.bat",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "clients/PkgNew.xlsx",
      "exists": true
    }
  ]
}
