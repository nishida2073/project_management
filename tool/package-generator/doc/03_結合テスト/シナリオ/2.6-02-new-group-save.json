{
  "name": "2.6-02 新規作成したグループは、保存すると設定ファイルと Excel ファイルができる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/新規作成"
    },
    {
      "action": "enterDialog",
      "window": "グループの新規作成",
      "value": "TestNew"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFile",
      "path": "clients/TestNew.bat",
      "exists": true
    },
    {
      "action": "expectFileContains",
      "path": "clients/TestNew.bat",
      "contains": "KintoneSubdomain=univ-kyousai-{x}"
    },
    {
      "action": "expectFile",
      "path": "clients/TestNew.xlsx",
      "exists": true
    },
    {
      "action": "shot"
    }
  ]
}
