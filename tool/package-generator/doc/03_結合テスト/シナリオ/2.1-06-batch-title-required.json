{
  "name": "2.1-06 一括実行で、パッケージのアップロードを選びタイトルが空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/タイトル",
      "value": ""
    },
    {
      "action": "typeAt",
      "part": "実行（一括実行）/フォルダ",
      "value": ""
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/パッケージのアップロード"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectMessage",
      "window": "一括実行",
      "contains": "タイトル を設定してください"
    }
  ]
}
