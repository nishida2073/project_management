{
  "name": "2.7-03 パッケージ定義ファイルを Excel で開いたままにして更新すると、状態が失敗になる",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 198,
      "y": 79
    },
    {
      "action": "selectComboAt",
