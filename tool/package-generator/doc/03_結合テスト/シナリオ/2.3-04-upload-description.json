{
  "name": "2.3-04 説明を入力してアップロードすると、説明がログに入る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/クリア（フォルダ）"
    },
    {
      "action": "typeAt",
      "part": "実行（パッケージ反映）/タイトル",
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "part": "実行（パッケージ反映）/ファイル1",
      "value": "{{root}}\\generated\\ok\\コースA.zip"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "pasteAt",
      "part": "実行（パッケージ反映）/説明",
      "value": "テスト説明"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "expectLogContains",
      "path": "logs",
      "filter": "upload-kintone-file*.log",
      "contains": "テスト説明"
    },
    {
      "action": "shot"
    }
  ]
}
