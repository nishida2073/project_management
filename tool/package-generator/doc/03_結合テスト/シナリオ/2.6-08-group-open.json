{
  "name": "2.6-08 グループ別の開くを押すと、対象のグループの Excel ファイルが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 107,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 722,
      "y": 131
    },
    {
      "action": "expectWindow",
      "title": "{{client}}.xlsx",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "{{client}}.xlsx"
    }
  ]
}
