{
  "name": "2.3-11 異常のクライアント（ng）で、パッケージのアップロードを実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（パッケージ反映）/タイトル",
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "part": "実行（パッケージ反映）/ファイル1",
      "value": "{{root}}\\generated\\ng\\コースA.zip"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/状態",
      "pattern": "^失敗$",
      "timeoutSec": 300
    }
  ]
}
