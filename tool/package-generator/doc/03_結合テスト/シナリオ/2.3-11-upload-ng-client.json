{
  "name": "2.3-11 異常のクライアント（ng）で、パッケージのアップロードを実行すると、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 238,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 181,
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 255,
      "value": "{{root}}/generated/ng/コースA.zip"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 483
    },
    {
      "action": "expectText",
      "text": "失敗",
      "timeoutSec": 300
    }
  ]
}
