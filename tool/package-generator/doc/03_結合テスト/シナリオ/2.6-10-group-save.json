{
  "name": "2.6-10 グループ別の設定を変えて保存すると、設定ファイルに保存される",
  "kind": "正常系",
  "setup": [
    {
      "action": "copyFile",
      "from": "clients/template/client.bat",
      "to": "clients/CopySrc.bat"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "CopySrc"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/サブドメイン",
      "value": "saved"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "clients/CopySrc.bat",
      "contains": "saved"
    }
  ]
}
