{
  "name": "2.6-10 グループ別の設定を変えて保存すると、設定ファイルに保存される",
  "setup": [
    {
      "action": "copyFile",
      "from": "clients/template/client.bat",
      "to": "clients/CopySrc.bat"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 107,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "CopySrc"
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 297,
      "value": "newsub"
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 169
    },
    {
      "action": "expectTextAt",
      "x": 200,
      "y": 169,
      "pattern": "^完了$",
      "timeoutSec": 60
    },
    {
      "action": "expectFileContains",
      "path": "clients/CopySrc.bat",
      "contains": "newsub"
    }
  ]
}
