{
  "name": "2.3-05 フォルダの「クリア」を押すと、フォルダの入力が消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/フォルダ",
      "pattern": "generated\\\\ok$",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/クリア（フォルダ）"
    },
    {
      "action": "expectTextGone",
      "text": "{{root}}\\generated\\ok"
    }
  ]
}
