{
  "name": "2.3-05 フォルダの「クリア」を押すと、フォルダの入力が消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 134,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 183
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "x": 238,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "expectText",
      "text": "{{root}}\\generated\\ok"
    },
    {
      "action": "clickAt",
      "x": 752,
      "y": 217
    },
    {
      "action": "expectTextGone",
      "text": "{{root}}\\generated\\ok"
    }
  ]
}
