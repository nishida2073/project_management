{
  "name": "2.4-02 ログの削除の確認で「はい」を選ぶと、ログが削除される",
  "kind": "正常系",
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "text": "generate-package-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "text": "generate-package-ng"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-ok_20261021_000000.log",
      "text": "upload-kintone-file-ok-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ng-ng_20261021_000000.log",
      "text": "upload-kintone-file-ng-ng"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "click",
      "target": "すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "{ENTER}"
    },
    {
      "action": "expectFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "exists": false
    },
    {
      "action": "expectFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "exists": false
    }
  ]
}
