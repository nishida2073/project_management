{
  "name": "2.2-06 パッケージ定義ファイルが存在しないと、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "deleteFile",
      "path": "clients/ok.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 134,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 183
    },
    {
      "action": "expectText",
      "text": "失敗",
      "timeoutSec": 60
    }
  ]
}
