{
  "name": "2.6-03 保存済みのグループをコピーすると、設定ファイルと Excel ファイルができる",
  "kind": "正常系",
  "setup": [
    {
      "action": "copyFile",
      "from": "clients/template/client.bat",
      "to": "clients/CopySrc.bat"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "CopySrc"
    },
    {
      "action": "click",
      "target": "コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "PkgCopy"
    },
    {
      "action": "expectFile",
      "path": "clients/PkgCopy.bat",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "clients/PkgCopy.xlsx",
      "exists": true
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "pattern": "^PkgCopy$",
      "timeoutSec": 30
    }
  ]
}
