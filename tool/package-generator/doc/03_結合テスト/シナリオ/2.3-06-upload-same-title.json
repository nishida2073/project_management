{
  "name": "2.3-06 同じタイトルでもう一度実行すると、既存のレコードが更新される",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 134,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 183
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "x": 238,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 752,
      "y": 217
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 181,
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 255,
      "value": "{{root}}\\generated\\ok\\コースA.zip"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 483
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 30
    },
    {
      "action": "wait",
      "ms": 2000
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 483
    },
    {
      "action": "expectLogContains",
      "path": "logs",
      "filter": "upload-kintone-file*.log",
      "contains": "同じタイトルのレコードを更新しました"
    }
  ]
