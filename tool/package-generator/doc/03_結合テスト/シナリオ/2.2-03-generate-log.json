{
  "name": "2.2-03 パッケージ作成が成功し、実行のログがログの出力先に保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectText",
      "text": "成功",
      "timeoutSec": 30
    },
    {
      "action": "expectLogFile",
      "path": "logs"
    }
  ]
}
