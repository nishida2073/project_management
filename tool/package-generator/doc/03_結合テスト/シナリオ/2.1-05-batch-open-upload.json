{
  "name": "2.1-05 一括実行のパッケージのアップロードの開くを押すと、対象の kintone アプリが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（パッケージのアップロード）"
    },
    {
      "action": "expectWindow",
      "title": "ファイル管理",
      "timeoutSec": 30
    },
    {
      "action": "closeWindow",
      "title": "ファイル管理",
      "keys": "^w"
    }
  ]
}
