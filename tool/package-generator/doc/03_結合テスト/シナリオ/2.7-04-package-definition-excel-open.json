{
  "name": "2.7-04 パッケージ定義ファイルを Excel で開いたままにして更新すると、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/パッケージ定義タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（パッケージ定義）/対象のグループ",
      "value": "ok"
    },
    {
      "action": "openFile",
      "path": "clients/ok.xlsx"
    },
    {
      "action": "wait",
      "ms": 8000
    },
    {
      "action": "clickAt",
      "part": "環境設定（パッケージ定義）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（パッケージ定義）/状態",
      "pattern": "^失敗$",
      "timeoutSec": 120
    },
    {
      "action": "closeWindow",
      "title": "ok.xlsx"
    }
  ]
}
