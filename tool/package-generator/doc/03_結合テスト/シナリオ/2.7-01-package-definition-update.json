{
  "name": "2.7-01 パッケージ定義ファイルの更新で、対象のグループのパッケージ定義が更新される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "download/test/sample.txt",
      "text": "sample\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/パッケージ定義タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（パッケージ定義）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（パッケージ定義）/実行（パッケージ定義ファイルの更新）"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（パッケージ定義）/状態（パッケージ定義ファイルの更新）",
      "pattern": "^成功$",
      "timeoutSec": 120
    },
    {
      "action": "shot"
    }
  ]
}
