{
  "name": "2.4-04 ログの対象のグループで「すべて」を選ぶと、すべてのグループのログが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "text": "generate-package-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "text": "generate-package-ng"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ok-460_20260101_000000.log",
      "text": "upload-kintone-file-ok-460"
    },
    {
      "action": "writeFile",
      "path": "logs/upload-kintone-file-ng-460_20260101_000000.log",
      "text": "upload-kintone-file-ng-460"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "ログ/対象のグループ",
      "value": ""
    },
    {
      "action": "expectEditContains",
      "text": "generate-package-ok",
      "timeoutSec": 15
    },
    {
      "action": "expectEditContains",
      "text": "generate-package-ng",
      "timeoutSec": 15
    }
  ]
}
