{
  "name": "2.1-01 一括実行で、パッケージのアップロードのチェックを外すと、アップロードはスキップされる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/パッケージのアップロード（チェック確認）",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージの作成）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージのアップロード）",
      "pattern": "^スキップ$",
      "timeoutSec": 60
    }
  ]
}
