{
  "name": "2.1-01 一括実行で、パッケージのアップロードのチェックを外すと、アップロードはスキップされる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "expectCheckedAt",
      "x": 57,
      "y": 297,
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 344
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 259,
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 291,
      "pattern": "^スキップ$",
      "timeoutSec": 60
    }
  ]
}
