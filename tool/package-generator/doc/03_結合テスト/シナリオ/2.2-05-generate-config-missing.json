{
  "name": "2.2-05 パッケージ定義ファイルが存在しないと、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "deleteFile",
      "path": "clients/ok.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
