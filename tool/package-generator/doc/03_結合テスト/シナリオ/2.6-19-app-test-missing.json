{
  "name": "2.6-19 ファイル管理のテスト接続で、存在しないアプリIDなら失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/対象アプリID",
      "value": "99999999"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（ファイル管理）"
    },
    {
      "action": "expectText",
      "text": "失敗",
      "timeoutSec": 60
    }
  ]
}
