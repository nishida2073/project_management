{
  "name": "2.6-35 ファイル管理の対象アプリIDを空にしてテスト接続すると、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/対象アプリID",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（ファイル管理）"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（テスト接続（ファイル管理））",
      "pattern": "^失敗$",
      "timeoutSec": 30
    },
    {
      "action": "shot"
    }
  ]
}
