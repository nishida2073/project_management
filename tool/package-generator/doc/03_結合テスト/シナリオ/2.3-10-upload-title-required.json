{
  "name": "2.3-10 パッケージ反映で、タイトルが空だと、メッセージが出る",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/実行"
    },
    {
      "action": "expectMessage",
      "window": "実行",
      "contains": "タイトルを入力してください"
    },
    {
      "action": "shot"
    }
  ]
}
