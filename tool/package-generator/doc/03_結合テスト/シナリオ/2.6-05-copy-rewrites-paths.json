{
  "name": "2.6-05 コピーすると、パッケージの出力先の名前が新しいグループの名前になる",
  "kind": "正常系",
  "setup": [
    {
      "action": "writeFile",
      "path": "clients/CopySrc.bat",
      "text": "set \"GenerateOutputPath=%BASE_PATH%generated\\CopySrc\"\r\nset \"KintoneSubdomain=univ-kyousai-{x}\"\r\n"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "CopySrc"
    },
    {
      "action": "click",
      "target": "コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "PkgCopy"
    },
    {
      "action": "expectFileContains",
      "path": "clients/PkgCopy.bat",
      "contains": "generated\\PkgCopy"
    }
  ]
}
