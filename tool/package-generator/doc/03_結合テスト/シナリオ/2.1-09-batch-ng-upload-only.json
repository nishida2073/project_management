{
  "name": "2.1-09 異常のクライアント（ng）で、パッケージのアップロードだけを一括実行すると、アップロードの状態に失敗と表示される",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 57,
      "y": 265
    },
    {
      "action": "clickAt",
      "x": 57,
      "y": 296
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 344
    },
    {
      "action": "expectEditContains",
      "text": "一括実行 完了",
      "timeoutSec": 900
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 291,
      "pattern": "^失敗$",
      "timeoutSec": 60
    }
  ]
}
