{
  "name": "2.1-04 一括実行のパッケージの作成の開くを押すと、パッケージの出力先のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 344
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 259,
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "x": 588,
      "y": 258
    },
    {
      "action": "expectWindow",
      "title": "{{client}}",
      "timeoutSec": 30
    },
    {
      "action": "closeWindow",
      "title": "{{client}}"
    }
  ]
}
