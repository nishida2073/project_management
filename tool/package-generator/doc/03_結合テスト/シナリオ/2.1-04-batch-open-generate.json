{
  "name": "2.1-04 一括実行のパッケージの作成の開くを押すと、パッケージの出力先のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージの作成）",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/開く（パッケージの作成）"
    },
    {
      "action": "expectWindow",
      "title": "{{client}}",
      "timeoutSec": 30
    },
    {
      "action": "closeWindow",
      "title": "{{client}}"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
