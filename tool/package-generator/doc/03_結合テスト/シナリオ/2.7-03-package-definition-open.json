{
  "name": "2.7-03 パッケージ定義ファイルの更新後の「開く」で、更新されたパッケージ定義ファイルが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/パッケージ定義タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（パッケージ定義）/対象のグループ",
      "value": "ok"
    },
    {
      "action": "clickAt",
      "part": "環境設定（パッケージ定義）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（パッケージ定義）/状態",
      "pattern": "^成功$",
      "timeoutSec": 120
    },
    {
      "action": "clickAt",
      "part": "環境設定（パッケージ定義）/開く"
    },
    {
      "action": "expectWindow",
      "title": "ok.xlsx",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "ok.xlsx"
    }
  ]
}
