{
  "name": "2.1-06 圧縮元のフォルダが存在しない（異常のクライアント）と、パッケージ作成は警告になっても後続のアップロードは続けて実行される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/パッケージのアップロード"
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/パッケージのアップロード（チェック確認）",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（一括実行）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージの作成）",
      "pattern": "^警告$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（パッケージのアップロード）",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（一括実行）",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
