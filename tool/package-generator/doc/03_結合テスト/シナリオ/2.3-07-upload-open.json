{
  "name": "2.3-07 パッケージ反映の開くを押すと、対象の kintone アプリが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/開く"
    },
    {
      "action": "expectWindow",
      "title": "ファイル管理",
      "timeoutSec": 30
    },
    {
      "action": "closeWindow",
      "title": "ファイル管理",
      "keys": "^w"
    }
  ]
}
