{
  "name": "2.6-06 グループ別の開くを押すと、対象のグループの Excel ファイルが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/開く（対象のグループ）"
    },
    {
      "action": "expectWindow",
      "title": "{{client}}.xlsx",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "{{client}}.xlsx"
    },
    {
      "action": "shot"
    }
  ]
}
