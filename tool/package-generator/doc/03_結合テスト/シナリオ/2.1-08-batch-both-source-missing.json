{
  "name": "2.1-08 圧縮元のフォルダが存在しない（異常のクライアント）と、パッケージ作成は失敗しても後続のアップロードは続けて実行される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 57,
      "y": 296
    },
    {
      "action": "expectCheckedAt",
      "x": 57,
      "y": 297,
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "clickAt",
      "x": 105,
      "y": 344
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 259,
      "pattern": "^警告$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "x": 535,
      "y": 291,
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    }
  ]
}
