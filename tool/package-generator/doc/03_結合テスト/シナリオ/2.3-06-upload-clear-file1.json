{
  "name": "2.3-06 ファイル1の「クリア」を押すと、ファイル1の入力が消える",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ作成タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ作成）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ作成）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ作成）/状態",
      "pattern": "^成功$",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "実行/パッケージ反映タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（パッケージ反映）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "part": "実行（パッケージ反映）/ファイル1",
      "value": "{{root}}\\generated\\ok\\コースA.zip"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/ファイル1",
      "pattern": "generated\\\\ok\\\\コースA\\.zip$",
      "timeoutSec": 30
    },
    {
      "action": "clickAt",
      "part": "実行（パッケージ反映）/クリア（ファイル1）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（パッケージ反映）/ファイル1",
      "pattern": "generated\\\\ok\\\\コースA\\.zip$",
      "absent": true,
      "timeoutSec": 10
    },
    {
      "action": "shot"
    }
  ]
}
