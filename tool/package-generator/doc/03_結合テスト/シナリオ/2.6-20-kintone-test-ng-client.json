{
  "name": "2.6-20 異常のクライアント（ng）を選び、誤ったパスワードでテスト接続（認証情報）を押すと、状態に失敗と表示される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/パスワード",
      "value": "wrong-password"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（認証情報）"
    },
    {
      "action": "expectText",
      "text": "失敗",
      "timeoutSec": 60
    }
  ]
}
