    },
    {
      "action": "clickAt",
      "x": 238,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 752,
      "y": 217
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 181,
      "value": "TestTitle"
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 255,
      "value": "{{root}}\\generated\\ok\\コースA.zip"
    },
    {
      "action": "pasteAt",
      "x": 420,
      "y": 390,
