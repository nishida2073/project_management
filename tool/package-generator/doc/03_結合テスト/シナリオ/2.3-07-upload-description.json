  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 134,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 144,
