{
  "name": "2.6-07 グループ別の設定で変えた値を再読込すると、保存されている値に戻る",
  "kind": "正常系",
  "setup": [
    {
      "action": "copyFile",
      "from": "clients/template/client.bat",
      "to": "clients/CopySrc.bat"
    },
    {
      "action": "copyFile",
      "from": "clients/template/client.xlsx",
      "to": "clients/CopySrc.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "CopySrc"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/サブドメイン",
      "value": "tmp"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/サブドメイン",
      "pattern": "^univ-kyousai-\\{x\\}$",
      "timeoutSec": 30
    }
  ]
}
