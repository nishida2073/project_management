  "steps": [
    {
      "action": "clickAt",
      "x": 152,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 107,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "CopySrc"
    },
    {
      "action": "typeAt",
      "x": 420,
      "y": 297,
