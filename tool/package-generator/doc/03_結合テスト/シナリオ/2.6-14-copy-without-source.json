{
  "name": "2.6-14 コピー元が保存されていないグループはコピーできない",
  "kind": "異常系",
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "click",
      "target": "新規作成"
    },
    {
      "action": "enterDialog",
      "window": "グループの新規作成",
      "value": "PkgUnsaved"
    },
    {
      "action": "expectText",
      "text": "PkgUnsaved"
    },
    {
      "action": "click",
      "target": "コピー"
    },
    {
      "action": "expectMessage",
      "window": "コピー作成",
      "contains": "コピー元のグループが存在しません。"
    },
    {
      "action": "expectFile",
      "path": "clients/PkgUnsaved.bat",
      "exists": false
    }
  ]
}
