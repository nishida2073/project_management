{
  "name": "2.4-02 ログの削除の確認で「いいえ」を選ぶと、ログは残る",
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/test.log",
      "text": "test log\r\n"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "click",
      "target": "すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "{TAB}{ENTER}"
    },
    {
      "action": "expectFile",
      "path": "logs/test.log",
      "exists": true
    }
  ]
}
