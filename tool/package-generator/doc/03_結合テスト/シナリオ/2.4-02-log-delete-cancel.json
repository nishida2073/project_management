{
  "name": "2.4-02 ログの削除の確認で「いいえ」を選ぶと、ログは残る",
  "kind": "正常系",
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "text": "generate-package-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "text": "generate-package-ng"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "click",
      "target": "すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "{TAB}{ENTER}"
    },
    {
      "action": "expectFile",
      "path": "logs/generate-package-ok_20260101_000000.log",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "logs/generate-package-ng_20260101_000000.log",
      "exists": true
    }
  ]
}
