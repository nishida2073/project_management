{
  "name": "2.5-03 環境設定（共通）で再読込を押すと、状態（再読込）が完了になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ]
}
