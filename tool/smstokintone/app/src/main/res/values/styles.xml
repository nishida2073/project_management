<resources>
    <!-- Widget.MaterialComponents.Button.OutlinedButtonの既定の枠線色は低透過のcolorOnSurfaceで、
         ダークモードでは背景（colorSurface）との明度差が小さく視認しづらいため、枠線をボタン文字と
         同じcolorPrimaryに変更する -->
    <style name="AppButton.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
    </style>

    <!-- キーワード行の追加／削除など、1文字程度の短いラベルを行内にコンパクトに収めるためのボタン。
         通常のOutlinedButtonにはMaterialの既定でminWidth(88dp)と上下のinsetがあり、短いラベルでも
         横幅を取ってしまうため、最小サイズとinset・paddingを切り詰める -->
    <style name="AppButton.CompactIconButton" parent="AppButton.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- アプリ内のカード共通スタイル。枠線を明示することで、影だけでは境界がわかりにくい
         ダークモードでもカードの区切りをはっきりさせる -->
    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/log_divider</item>
    </style>
</resources>
