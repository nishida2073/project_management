{
  "name": "2.4-04 実施結果集計（アンケート）の実行が終わったあと、開くを押すと、アンケート集計結果のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 345,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 269,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 309
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "x": 257,
      "y": 309
    },
    {
      "action": "expectWindow",
      "title": "アンケート",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "アンケート"
    }
  ]
}
