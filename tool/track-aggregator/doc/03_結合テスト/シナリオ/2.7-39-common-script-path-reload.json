{
  "name": "2.7-39 trackダウンロード用スクリプトのパスを変えて再読込を押すと、保存されている値に戻る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/共通タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wheelAt",
      "x": 300,
      "y": 500,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "wheelAt",
      "x": 300,
      "y": 500,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/trackダウンロード用スクリプトのパス",
      "value": "tmp-reload"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/trackダウンロード用スクリプトのパス",
      "pattern": "^{{AutoHotkeyScriptPathRe}}$",
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ],
  "fixtureVars": {
    "AutoHotkeyScriptPath": "AutoHotkeyScriptPath"
  },
  "fixtureFile": "bats\\common.bat"
}
