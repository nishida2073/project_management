{
  "name": "2.2-06 実施結果取得（取得状況確認）の実行が終わったあと、開くを押すと、取得した結果のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（テスト）"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（取得状況確認）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（取得状況確認）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/開く（取得状況確認）"
    },
    {
      "action": "expectWindow",
      "title": "実施結果",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "実施結果"
    }
  ]
}
