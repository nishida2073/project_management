{
  "name": "2.2-06 実施結果取得（取得状況確認）の実行が終わったあと、開くを押すと、出力先のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "output/実施結果/01_テスト/{{client}}/社会を支えるITサービス"
    },
    {
      "action": "writeFile",
      "path": "output/実施結果/01_テスト/{{client}}/社会を支えるITサービス/{{client}}-result.csv",
      "text": "名前,点数\r\nテスト,80",
      "encoding": "UTF8"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（取得状況確認）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（取得状況確認）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60,
      "part": "実行（実施結果取得）/状態（取得状況確認）"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/開く（取得状況確認）"
    },
    {
      "action": "expectWindow",
      "title": "実施結果",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "実施結果"
    },
    {
      "action": "shot"
    }
  ]
}
