{
  "name": "2.8-11 環境設定（グループ別）で、既存のグループと同じ名前で新規作成すると、既に存在する旨が表示され、追加されない",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/新規作成"
    },
    {
      "action": "enterDialog",
      "window": "グループの新規作成",
      "value": "{{client}}"
    },
    {
      "action": "expectMessage",
      "window": "グループの新規作成",
      "contains": "既に存在します"
    }
  ]
}
