{
  "name": "2.2-01 実施結果取得（テスト）で、対象のグループを選び実行すると、状態が成功または警告になり、テストの実施結果が取得される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（テスト）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    }
  ]
}
