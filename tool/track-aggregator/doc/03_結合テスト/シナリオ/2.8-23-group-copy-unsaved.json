{
  "name": "2.8-23 環境設定（グループ別）で新規作成直後の未保存グループをコピーすると、コピー元が存在しない旨が表示される",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/新規作成"
    },
    {
      "action": "enterDialog",
      "window": "グループの新規作成",
      "value": "TestUnsaved"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/コピー"
    },
    {
      "action": "expectMessage",
      "window": "コピー作成",
      "contains": "コピー元のグループが存在しません。"
    },
    {
      "action": "shot"
    }
  ]
}
