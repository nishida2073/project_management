{
  "name": "2.8-09 環境設定（グループ別）で新規作成を押したあとキャンセルすると、一覧は変わらない",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/新規作成"
    },
    {
      "action": "closeWindow",
      "title": "グループの新規作成",
      "keys": "{ESC}"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "pattern": "^TrackCancel$",
      "absent": true,
      "timeoutSec": 10
    }
  ]
}
