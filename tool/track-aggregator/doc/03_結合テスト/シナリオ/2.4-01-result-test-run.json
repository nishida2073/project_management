{
  "name": "2.4-01 実施結果集計（テスト）で、対象のグループを選び実行すると、状態が成功または警告になり、テストの集計結果が作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "output/実施結果/01_テスト/{{client}}/社会を支えるITサービス"
    },
    {
      "action": "writeFile",
      "path": "output/実施結果/01_テスト/{{client}}/社会を支えるITサービス/{{client}}-result.csv",
      "text": "名前,点数\r\nテスト,80",
      "encoding": "UTF8"
    },
    {
      "action": "makeDir",
      "path": "output/実施結果/02_アンケート/{{client}}/社会を支えるITサービス"
    },
    {
      "action": "writeFile",
      "path": "output/実施結果/02_アンケート/{{client}}/社会を支えるITサービス/{{client}}-result.csv",
      "text": "名前,点数\r\nテスト,80",
      "encoding": "UTF8"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果集計タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果集計）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果集計）/実行（テスト）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800,
      "part": "実行（実施結果集計）/状態（テスト）"
    },
    {
      "action": "expectFile",
      "path": "output/集計結果/テスト/ok-テスト結果.xlsx",
      "exists": true
    },
    {
      "action": "shot"
    }
  ]
}
