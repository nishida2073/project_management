{
  "name": "2.8-08 環境設定（グループ別）で経年比較の比較年数を変えて保存を押すと、変えた値が設定ファイルに保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 300,
      "y": 500,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "wheelAt",
      "x": 300,
      "y": 500,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/経年比較の比較年数",
      "value": "3"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "clients/ok.bat",
      "contains": "ComparePeriod=3"
    }
  ]
}
