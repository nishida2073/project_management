{
  "name": "2.8-03 環境設定（グループ別）で入力欄の値を変えて保存を押すと、値が設定ファイルに保存され、画面の表示が更新される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/サブドメイン",
      "value": "saved"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/保存の状態",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectEditContains",
      "text": "saved"
    }
  ]
}
