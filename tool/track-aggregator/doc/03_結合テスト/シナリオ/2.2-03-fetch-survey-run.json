{
  "name": "2.2-03 実施結果取得（アンケート）で、対象のグループを選び実行すると、状態が成功または警告になり、アンケートの実施結果が取得される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（アンケート）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（アンケート）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60,
      "part": "実行（実施結果取得）/状態（アンケート）"
    },
    {
      "action": "expectFile",
      "path": "output/実施結果/02_アンケート/ok/社会を支えるITサービス",
      "filter": "nttdata-univ-class_results*.csv",
      "exists": true
    },
    {
      "action": "shot"
    }
  ]
}
