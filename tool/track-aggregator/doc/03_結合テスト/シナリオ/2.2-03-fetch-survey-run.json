{
  "name": "2.2-03 実施結果取得（アンケート）で、対象のグループを選び実行すると、状態が成功または警告になり、アンケートの実施結果が取得される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 135,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 269,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 309
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    }
  ]
}
