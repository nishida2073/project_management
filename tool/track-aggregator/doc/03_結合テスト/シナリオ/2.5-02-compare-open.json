{
  "name": "2.5-02 経年比較の実行が終わったあと、開くを押すと、経年比較の結果のフォルダが開く",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 435,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 221
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "x": 257,
      "y": 221
    },
    {
      "action": "expectWindow",
      "title": "経年比較",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "経年比較"
    }
  ]
}
