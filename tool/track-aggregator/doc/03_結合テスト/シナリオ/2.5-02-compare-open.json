{
  "name": "2.5-02 経年比較の実行が終わったあと、開くを押すと、経年比較の結果のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/経年比較タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（経年比較）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（経年比較）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（経年比較）/開く"
    },
    {
      "action": "expectWindow",
      "title": "経年比較",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "経年比較"
    }
  ]
}
