{
  "name": "2.5-02 経年比較の実行が終わったあと、開くを押すと、出力先のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/経年比較タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（経年比較）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（経年比較）/実行"
    },
    {
      "action": "waitDoneAt",
      "part": "実行（経年比較）/状態",
      "timeoutSec": 9000
    },
    {
      "action": "clickAt",
      "part": "実行（経年比較）/開く"
    },
    {
      "action": "expectWindow",
      "title": "経年比較",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "経年比較"
    },
    {
      "action": "shot"
    }
  ]
}
