{
  "name": "2.1-01 一括実行で、対象のグループを選び、チェックされている処理のまま実行すると、処理ごとの状態が成功または警告になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果取得-テスト",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果取得-アンケート",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケート",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果集計-テスト",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果集計-アンケート",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果集計-投稿",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/経年比較-アンケート・テスト",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-テストの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-テストの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "output/集計結果/テスト/ok-テスト結果.xlsx",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "output/集計結果/アンケート/ok-アンケート結果.xlsx",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "output/実施結果/01_テスト/ok/社会を支えるITサービス",
      "filter": "nttdata-univ-material_results*.csv",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "output/実施結果/02_アンケート/ok/社会を支えるITサービス",
      "filter": "nttdata-univ-class_results*.csv",
      "exists": true
    }
  ]
}
