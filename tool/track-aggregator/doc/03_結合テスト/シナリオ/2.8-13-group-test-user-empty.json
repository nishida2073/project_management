{
  "name": "2.8-13 環境設定（グループ別）でユーザーの対象アプリIDを空にして、テスト接続（ユーザー）を押すと、状態が失敗になり、接続は行われない",
  "kind": "異常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/対象アプリID（ユーザー）",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/テスト接続（ユーザー）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectMessage",
      "window": "エラー",
      "contains": "対象アプリIDを入力してください"
    }
  ]
}
