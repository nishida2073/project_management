{
  "name": "2.2-04 実施結果取得（アンケート）の実行が終わったあと、開くを押すと、取得した結果のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（アンケート）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（アンケート）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60,
      "part": "実行（実施結果取得）/状態（アンケート）"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/開く（アンケート）"
    },
    {
      "action": "expectWindow",
      "title": "02_アンケート",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "02_アンケート"
    }
  ]
}
