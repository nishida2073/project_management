{
  "name": "2.4-02 実施結果集計（テスト）の実行が終わったあと、開くを押すと、テスト集計結果のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果集計タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果集計）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果集計）/実行（テスト）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果集計）/開く（テスト）"
    },
    {
      "action": "expectWindow",
      "title": "テスト",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "テスト"
    }
  ]
}
