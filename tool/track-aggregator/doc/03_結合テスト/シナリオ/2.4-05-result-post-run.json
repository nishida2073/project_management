{
  "name": "2.4-05 実施結果集計（投稿）で、対象のグループを選び実行すると、状態が成功または警告になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "output/集計結果/テスト"
    },
    {
      "action": "makeDir",
      "path": "output/集計結果/アンケート"
    },
    {
      "action": "copyFile",
      "from": "template/テスト結果.xlsx",
      "to": "output/集計結果/テスト/{{client}}-テスト結果.xlsx"
    },
    {
      "action": "copyFile",
      "from": "template/アンケート結果.xlsx",
      "to": "output/集計結果/アンケート/{{client}}-アンケート結果.xlsx"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果集計タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果集計）/対象のグループ（投稿）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果集計）/実行（投稿）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800,
      "part": "実行（実施結果集計）/状態（投稿）"
    }
  ]
}
