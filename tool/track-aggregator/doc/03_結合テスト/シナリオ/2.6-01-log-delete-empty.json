{
  "name": "2.6-01 ログのファイルがない状態で、すべて削除を押すと、削除対象のログファイルがないことが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "makeDir",
      "path": "logs"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 530,
      "y": 103
    },
    {
      "action": "expectMessage",
      "window": "ログの削除",
      "contains": "削除対象のログファイルがありません"
    }
  ]
}
