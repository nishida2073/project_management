{
  "name": "2.8-13 投稿先スレッドIDを変えて再読込を押すと、保存されている値に戻る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": 3000
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/投稿先スレッドID",
      "value": "tmp-reload"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/投稿先スレッドID",
      "pattern": "^229$",
      "timeoutSec": 15
    }
  ]
}
