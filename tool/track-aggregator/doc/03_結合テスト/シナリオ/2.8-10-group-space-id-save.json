{
  "name": "2.8-10 投稿先スペースIDを変えて保存を押すと、変えた値が設定ファイルに保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": 3000
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "typeAt",
      "part": "環境設定（グループ別）/投稿先スペースID",
      "value": "saved-space-id"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/保存"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/状態（保存）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectFileContains",
      "path": "clients/ok.bat",
      "contains": "SpaceId=saved-space-id"
    }
  ]
}
