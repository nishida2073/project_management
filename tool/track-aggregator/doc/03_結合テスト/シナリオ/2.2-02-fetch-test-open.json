{
  "name": "2.2-02 実施結果取得（テスト）の実行が終わったあと、開くを押すと、出力先のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（テスト）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60,
      "part": "実行（実施結果取得）/状態（テスト）"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/開く（テスト）"
    },
    {
      "action": "expectWindow",
      "title": "01_テスト",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "01_テスト"
    },
    {
      "action": "shot"
    }
  ]
}
