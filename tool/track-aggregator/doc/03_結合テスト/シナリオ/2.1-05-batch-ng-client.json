{
  "name": "2.1-05 一括実行で、異常のクライアント（ng）で実行すると、実施結果取得-テストの状態が失敗になり、後続の処理は実行される",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行（一括実行）"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-テストの状態",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-アンケートの状態",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケートの状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-テストの状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-アンケートの状態",
      "pattern": "^成功$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/状態（一括実行）",
      "pattern": "^失敗$",
      "timeoutSec": 60
    },
    {
      "action": "shot"
    }
  ]
}
