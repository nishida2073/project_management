{
  "name": "2.6-04 ログの対象のグループを、すべて・ok・ng と切り替えると、選んだグループの実行ログだけが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/download-test-results-ok_20261021_000000.log",
      "text": "test ok run"
    },
    {
      "action": "writeFile",
      "path": "logs/download-test-results-ng_20261021_000000.log",
      "text": "test ng run"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "selectComboAt",
      "x": 324,
      "y": 104,
      "value": ""
    },
    {
      "action": "expectEditContains",
      "text": "test ok run",
      "timeoutSec": 30
    },
    {
      "action": "expectEditContains",
      "text": "test ng run",
      "timeoutSec": 30
    },
    {
      "action": "selectComboAt",
      "x": 324,
      "y": 104,
      "value": "{{client}}"
    },
    {
      "action": "expectEditContains",
      "text": "test ok run",
      "timeoutSec": 30
    },
    {
      "action": "expectEditNotContains",
      "text": "test ng run",
      "timeoutSec": 30
    }
  ]
}
