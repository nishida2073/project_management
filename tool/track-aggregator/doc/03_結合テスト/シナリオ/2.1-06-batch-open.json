{
  "name": "2.1-06 一括実行の処理の開くを、すべての行で押すと、それぞれの出力先のフォルダ（またはブラウザ）が開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施結果集計-投稿"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/経年比較-アンケート・テスト"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectEditContains",
      "text": "一括実行 完了",
      "timeoutSec": 900
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-テストの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-テストの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施結果取得-テストの開く"
    },
    {
      "action": "expectWindow",
      "title": "01_テスト",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "01_テスト"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施結果取得-アンケートの開く"
    },
    {
      "action": "expectWindow",
      "title": "02_アンケート",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "02_アンケート"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケートの開く"
    },
    {
      "action": "expectWindow",
      "title": "統合",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "統合"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施結果集計-テストの開く"
    },
    {
      "action": "expectWindow",
      "title": "テスト",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "テスト"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施結果集計-アンケートの開く"
    },
    {
      "action": "expectWindow",
      "title": "アンケート",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "アンケート"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実施結果集計-投稿の開く"
    },
    {
      "action": "expectWindow",
      "title": "Google Chrome",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "Google Chrome",
      "keys": "^w"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/経年比較-アンケート・テストの開く"
    },
    {
      "action": "expectWindow",
      "title": "経年比較",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "経年比較"
    }
  ]
}
