{
  "name": "2.4-03 実施結果集計（アンケート）で、対象のグループを選び実行すると、状態が成功または警告になり、アンケートの集計結果が作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果集計タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果集計）/対象のグループ（アンケート）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果集計）/実行（アンケート）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    }
  ]
}
