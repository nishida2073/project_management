{
  "name": "2.2-08 異常のクライアント（ng）で実施結果取得（アンケート）を実行すると、状態が失敗になる",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 135,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 269,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 309
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 300
    }
  ]
}
