{
  "name": "2.2-08 異常のクライアント（ng）で実施結果取得（アンケート）を実行すると、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（アンケート）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（アンケート）"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 300
    }
  ]
}
