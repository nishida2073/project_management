{
  "name": "2.9-05 環境設定（マスター）でテスト名などを変えて保存を押すと、値が保存され、画面の表示が更新される",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 145,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 167,
      "y": 80
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "{{client}}"
    },
    {
      "action": "pasteAt",
      "x": 190,
      "y": 454,
      "value": "テスト科目"
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 169
    },
    {
      "action": "expectTextAt",
      "x": 200,
      "y": 169,
      "pattern": "^完了$",
      "timeoutSec": 60
    },
    {
      "action": "expectEditContains",
      "text": "テスト科目"
    }
  ]
}
