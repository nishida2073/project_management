    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": 3000
    },
    {
      "action": "typeAt",
      "x": 520,
      "y": 508,
      "value": ""
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
