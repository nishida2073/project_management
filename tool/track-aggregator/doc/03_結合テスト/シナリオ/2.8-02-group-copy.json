{
  "name": "2.8-02 環境設定（グループ別）で保存済みのグループをコピーすると、新しいグループが 1 つ追加され、設定ファイルと Excel ファイルがコピーされる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/グループ別タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "環境設定（グループ別）/コピー"
    },
    {
      "action": "enterDialog",
      "window": "グループのコピー作成",
      "value": "TrackCopy"
    },
    {
      "action": "expectFile",
      "path": "clients/TrackCopy.bat",
      "exists": true
    },
    {
      "action": "expectFile",
      "path": "clients/TrackCopy.xlsx",
      "exists": true
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（グループ別）/対象のグループ",
      "pattern": "^TrackCopy$",
      "timeoutSec": 30
    }
  ]
}
