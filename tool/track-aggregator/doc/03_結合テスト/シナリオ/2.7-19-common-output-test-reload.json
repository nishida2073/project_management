{
  "name": "2.7-19 テスト集計結果の出力先を変えて再読込を押すと、保存されている値に戻る",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "typeAt",
      "part": "環境設定（共通）/テスト集計結果の出力先",
      "value": "tmp-reload"
    },
    {
      "action": "clickAt",
      "part": "環境設定（共通）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（共通）/テスト集計結果の出力先",
      "pattern": "^%OutputRootDir%\\\\テスト$",
      "timeoutSec": 15
    }
  ]
}
