      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "clickAt",
      "x": 57,
      "y": 189
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 431
    },
    {
      "action": "expectTextPattern",
