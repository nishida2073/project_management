{
  "name": "2.2-05 実施結果取得（取得状況確認）で、対象のグループを選び実行すると、状態が成功または警告になる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（取得状況確認）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（取得状況確認）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^成功$",
      "timeoutSec": 60,
      "part": "実行（実施結果取得）/状態（取得状況確認）"
    },
    {
      "action": "shot"
    }
  ]
}
