{
  "name": "2.2-07 異常のクライアント（ng）で実施結果取得（テスト）を実行すると、状態が失敗になる",
  "kind": "異常系",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（テスト）"
    },
    {
      "action": "expectTextAt",
      "pattern": "^失敗$",
      "timeoutSec": 300,
      "part": "実行（実施結果取得）/状態（テスト）"
    }
  ]
}
