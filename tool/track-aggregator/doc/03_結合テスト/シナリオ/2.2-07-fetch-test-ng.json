{
  "name": "2.2-07 異常のクライアント（ng）で実施結果取得（テスト）を実行すると、状態が失敗になる",
  "vars": {
    "client": "ng"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 135,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 184
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 300
    }
  ]
}
