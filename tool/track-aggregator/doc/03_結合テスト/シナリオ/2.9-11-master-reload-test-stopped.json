{
  "name": "2.9-11 環境設定（マスター）の停止中を切り替えたあと再読込を押すと、保存されている値で表示し直される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "wheelAt",
      "x": 800,
      "y": 450,
      "delta": -1200
    },
    {
      "action": "wait",
      "ms": 800
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/テスト表の停止中（1行目）",
      "value": "TRUE"
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/再読込"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/状態（再読込）",
      "pattern": "^完了$",
      "timeoutSec": 15
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/テスト表の停止中（1行目）",
      "pattern": "^FALSE$",
      "timeoutSec": 15
    },
    {
      "action": "shot"
    }
  ]
}
