{
  "name": "2.5-01 経年比較で、対象のグループと比較年を指定して実行すると、状態が成功または警告になり、経年比較の結果が作られる",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/経年比較タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（経年比較）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "part": "実行（経年比較）/対象の会社名",
      "value": ""
    },
    {
      "action": "clickAt",
      "part": "実行（経年比較）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    }
  ]
}
