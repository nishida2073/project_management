{
  "name": "2.6-02 ログのファイルがある状態で、すべて削除を押し、確認で「はい」を選ぶと、ログのファイルがすべて削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/download-test-results-ok_20260101_000000.log",
      "text": "download-test-results-ok"
    },
    {
      "action": "writeFile",
      "path": "logs/download-test-results-ng_20260101_000000.log",
      "text": "download-test-results-ng"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/ログタブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "ログ/すべて削除"
    },
    {
      "action": "expectDialogText",
      "window": "ログの削除",
      "contains": "ログファイルを削除します"
    },
    {
      "action": "pressKey",
      "window": "ログの削除",
      "key": "y"
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "download\\-test\\-results\\-ok",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    },
    {
      "action": "expectTextAt",
      "part": "ログ/ログ欄",
      "pattern": "download\\-test\\-results\\-ng",
      "tolX": 500,
      "tolY": 180,
      "timeoutSec": 15,
      "absent": true
    }
  ]
}
