{
  "name": "2.3-02 実施状況確認の実行が終わったあと、開くを押すと、統合結果のフォルダが開く",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施状況確認タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施状況確認）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施状況確認）/実行"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "clickAt",
      "part": "実行（実施状況確認）/開く"
    },
    {
      "action": "expectWindow",
      "title": "統合",
      "timeoutSec": 60
    },
    {
      "action": "closeWindow",
      "title": "統合"
    }
  ]
}
