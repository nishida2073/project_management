{
  "name": "2.1-04 一括実行が終わると、処理ごとに成功、警告、失敗のいずれかが表示される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果取得-テスト",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果取得-アンケート",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケート",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果集計-テスト",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果集計-アンケート",
      "checked": true,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/実施結果集計-投稿",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "expectCheckedAt",
      "part": "実行（一括実行）/経年比較-アンケート・テスト",
      "checked": false,
      "timeoutSec": 15
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-テストの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-アンケートの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケートの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-テストの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-アンケートの状態",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 60
    }
  ]
}
