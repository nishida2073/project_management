{
  "name": "2.3-01 実施状況確認で、対象のグループを選び実行すると、状態が成功または警告になり、取得した結果が統合される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施結果取得タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施結果取得）/対象のグループ（テスト）",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施結果取得）/実行（テスト）"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 900
    },
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/実施状況確認タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（実施状況確認）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（実施状況確認）/実行"
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 1800
    }
  ]
}
