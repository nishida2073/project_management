{
  "name": "2.1-05 一括実行が終わると、画面下部に実行ログが表示され、ログの出力先に保存される",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 25,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 45,
      "y": 79
    },
    {
      "action": "selectComboAt",
      "x": 328,
      "y": 144,
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "x": 104,
      "y": 431
    },
    {
      "action": "expectTextPattern",
      "pattern": "^(成功|警告|失敗)$",
      "timeoutSec": 1800
    },
    {
      "action": "expectFile",
      "path": "logs",
      "exists": true
    }
  ]
}
