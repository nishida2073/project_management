{
  "name": "2.1-05 一括実行が終わると、画面下部に実行ログが表示され、ログの出力先に保存される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/実行タブ"
    },
    {
      "action": "clickAt",
      "part": "実行/一括実行タブ"
    },
    {
      "action": "selectComboAt",
      "part": "実行（一括実行）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "clickAt",
      "part": "実行（一括実行）/実行"
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-テストの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果取得-アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施状況確認-テスト・アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-テストの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectTextAt",
      "part": "実行（一括実行）/実施結果集計-アンケートの状態",
      "pattern": "^(成功|警告)$",
      "timeoutSec": 60
    },
    {
      "action": "expectFile",
      "path": "logs",
      "exists": true
    }
  ]
}
