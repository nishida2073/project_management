{
  "name": "2.9-02 環境設定（マスター）のテストの表で行を選んで削除（テスト）を押すと、選んだ行が削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 145,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 167,
      "y": 80
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "{{client}}"
    },
    {
      "action": "expectTextAt",
      "x": 190,
      "y": 454,
      "pattern": "^社会を支えるITサービス$",
      "timeoutSec": 60
    },
    {
      "action": "clickAt",
      "x": 1022,
      "y": 454
    },
    {
      "action": "expectTextAt",
      "x": 190,
      "y": 454,
      "pattern": "^(?!社会を支えるITサービス$).+$",
      "timeoutSec": 60
    }
  ]
}
