{
  "name": "2.9-02 環境設定（マスター）のテストの表で行を選んで削除（テスト）を押すと、選んだ行が削除される",
  "kind": "正常系",
  "vars": {
    "client": "ok"
  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "part": "メニュー/環境設定タブ"
    },
    {
      "action": "clickAt",
      "part": "環境設定/マスタータブ"
    },
    {
      "action": "selectComboAt",
      "part": "環境設定（マスター）/対象のグループ",
      "value": "{{client}}"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/テスト表のテスト名（1行目）",
      "pattern": "^社会を支えるITサービス$",
      "timeoutSec": 60
    },
    {
      "action": "clickAt",
      "part": "環境設定（マスター）/テスト表の1行目の削除"
    },
    {
      "action": "expectTextAt",
      "part": "環境設定（マスター）/テスト表のテスト名（1行目）",
      "pattern": "^(?!社会を支えるITサービス$).+$",
      "timeoutSec": 60
    }
  ]
}
