  },
  "setup": [],
  "steps": [
    {
      "action": "clickAt",
      "x": 145,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 80
    },
    {
      "action": "selectComboAt",
      "x": 330,
      "y": 131,
      "value": "{{client}}"
    },
    {
      "action": "typeAt",
      "x": 520,
      "y": 367,
      "value": "wrong-password"
    },
    {
      "action": "clickAt",
      "x": 98,
      "y": 406
    },
    {
      "action": "expectTextPattern",
      "pattern": "^失敗$",
      "timeoutSec": 60
    }
  ]
}
