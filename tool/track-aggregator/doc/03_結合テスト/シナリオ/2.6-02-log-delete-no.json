{
  "name": "2.6-02 ログのファイルがある状態で、すべて削除を押し、確認で「いいえ」を選ぶと、ログのファイルは残る",
  "vars": {
    "client": "ok"
  },
  "setup": [
    {
      "action": "writeFile",
      "path": "logs/test.log",
      "text": "test"
    }
  ],
  "steps": [
    {
      "action": "clickAt",
      "x": 82,
      "y": 52
    },
    {
      "action": "clickAt",
      "x": 530,
      "y": 103
    },
    {
      "action": "expectMessage",
      "window": "確認",
      "contains": "削除しますか"
    },
    {
      "action": "pressKey",
      "window": "確認",
      "key": "n"
    },
    {
      "action": "expectFile",
      "path": "logs/test.log",
      "exists": true
    }
  ]
}
